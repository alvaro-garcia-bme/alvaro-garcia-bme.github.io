---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout activeTab="contact" title="Contact | Álvaro García Casas">
	<section class="py-8 sm:py-16 max-w-3xl mx-auto">
		<!-- Header -->
		<div class="text-center mb-12">
			<h1 class="text-4xl sm:text-5xl font-extrabold text-[#10172b] tracking-tight">
				Let’s Connect.
			</h1>
			<p class="mt-4 text-base sm:text-lg text-[#485569] leading-relaxed max-w-2xl mx-auto">
				I am a person who is always learning and who loves bringing a fresh perspective to whatever I am working on. I adapt well to new challenges and new environments, and I find that the most interesting work tends to happen right where different disciplines meet.
			</p>
			<p class="mt-2 text-base font-medium text-[#10172b]">
				If you want to know more or just connect, feel free to reach out.
			</p>
			<div class="mt-4 inline-flex items-center gap-2 text-xs font-semibold text-[#485569] bg-white border border-[#10172b]/10 px-3 py-1 rounded-full shadow-2xs">
				<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
				<span>Based in Madrid, España</span>
			</div>
		</div>

		<!-- Big Visual Icon Action Grid (Point 17: Simplificado) -->
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
			<!-- Email Action -->
			<a 
				href="mailto:alvaro.garcia.bme@gmail.com" 
				class="p-6 rounded-2xl border border-[#10172b]/10 bg-white hover:border-[#1a4478] hover:shadow-md transition-all flex items-center gap-5 group"
			>
				<div class="w-14 h-14 rounded-2xl bg-[#10172b]/5 text-[#10172b] flex items-center justify-center shrink-0 group-hover:bg-[#1a4478] group-hover:text-white transition-colors">
					<!-- Refined Modern Email Icon -->
					<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M2.5 7C2.5 5.61929 3.61929 4.5 5 4.5H19C20.3807 4.5 21.5 5.61929 21.5 7V17C21.5 18.3807 20.3807 19.5 19 19.5H5C3.61929 19.5 2.5 18.3807 2.5 17V7Z" stroke="currentColor" stroke-width="1.8"/>
						<path d="M3 6.5L10.9393 12.8515C11.5645 13.3516 12.4355 13.3516 13.0607 12.8515L21 6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
						<path d="M3.5 18L8.5 13.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.35"/>
						<path d="M20.5 18L15.5 13.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.35"/>
					</svg>
				</div>
				<div>
					<span class="text-base font-bold text-[#10172b] group-hover:text-[#1a4478] transition-colors">
						Send an Email &rarr;
					</span>
				</div>
			</a>

			<!-- LinkedIn Action -->
			<a 
				href="https://www.linkedin.com/in/alvaro-garcia-casas/" 
				target="_blank" 
				rel="noopener noreferrer" 
				class="p-6 rounded-2xl border border-[#10172b]/10 bg-white hover:border-[#1a4478] hover:shadow-md transition-all flex items-center gap-5 group"
			>
				<div class="w-14 h-14 rounded-2xl bg-[#10172b]/5 text-[#10172b] flex items-center justify-center shrink-0 group-hover:bg-[#1a4478] group-hover:text-white transition-colors">
					<!-- LinkedIn Icon -->
					<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
						<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
					</svg>
				</div>
				<div>
					<span class="text-base font-bold text-[#10172b] group-hover:text-[#1a4478] transition-colors">
						Connect on LinkedIn &rarr;
					</span>
				</div>
			</a>

			<!-- GitHub Action -->
			<a 
				href="https://github.com/alvaro-garcia-bme" 
				target="_blank" 
				rel="noopener noreferrer" 
				class="p-6 rounded-2xl border border-[#10172b]/10 bg-white hover:border-[#1a4478] hover:shadow-md transition-all flex items-center gap-5 group"
			>
				<div class="w-14 h-14 rounded-2xl bg-[#10172b]/5 text-[#10172b] flex items-center justify-center shrink-0 group-hover:bg-[#1a4478] group-hover:text-white transition-colors">
					<!-- GitHub Icon -->
					<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
						<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
					</svg>
				</div>
				<div>
					<span class="text-base font-bold text-[#10172b] group-hover:text-[#1a4478] transition-colors">
						View on GitHub &rarr;
					</span>
				</div>
			</a>

			<!-- CV Download Action -->
			<a 
				href="/CVs/CV_portfolio_EN.pdf" 
				target="_blank" 
				class="p-6 rounded-2xl border border-[#10172b]/10 bg-white hover:border-[#1a4478] hover:shadow-md transition-all flex items-center gap-5 group"
			>
				<div class="w-14 h-14 rounded-2xl bg-[#10172b]/5 text-[#10172b] flex items-center justify-center shrink-0 group-hover:bg-[#1a4478] group-hover:text-white transition-colors">
					<!-- Refined Modern CV / Resume Icon -->
					<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
						<rect x="4" y="3" width="16" height="18" rx="2.5" stroke="currentColor" stroke-width="1.8"/>
						<circle cx="9" cy="8.5" r="2" stroke="currentColor" stroke-width="1.5"/>
						<path d="M6.8 12.5C6.8 11.4 7.7 10.5 8.8 10.5H9.2C10.3 10.5 11.2 11.4 11.2 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
						<path d="M13.5 7.5H16.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
						<path d="M13.5 10.5H16.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
						<path d="M7.5 15.5H16.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
						<path d="M7.5 18H13.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
					</svg>
				</div>
				<div>
					<span class="text-base font-bold text-[#10172b] group-hover:text-[#1a4478] transition-colors">
						Download CV &rarr;
					</span>
				</div>
			</a>
		</div>
	</section>
</MainLayout>
