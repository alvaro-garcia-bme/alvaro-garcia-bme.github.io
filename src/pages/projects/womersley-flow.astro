<script is:inline>
(function() {
	// ────────────────────────────────────────────────────────
	// 1. MAIN WOMERSLEY VELOCITY PROFILE SIMULATOR
	// ────────────────────────────────────────────────────────
	const canvas = document.getElementById('womersleyCanvas');
	if (!canvas) return;
	const ctx = canvas.getContext('2d');

	const buttons = document.querySelectorAll('.alpha-btn');
	const alphaDisplay = document.getElementById('currentAlpha');
	const annotationEl = document.getElementById('regime-annotation');
	const phaseLabel = document.getElementById('phaseLabel');
	const regimeTag = document.getElementById('regime-tag');

	// Empirical regimes strictly matched to the laboratory reference dataset
	const regimes = {
		'1': {
			label: '&alpha; = 1.0',
			tag: 'Peak Center: 1.00 u_max &bull; Pure Parabola',
			annotation: '<strong class="text-cyan-400">[&alpha; = 1.0 &mdash; VISCOUS PARABOLIC]:</strong> Quasi-steady flow. Viscous diffusion acts rapidly across the lumen. Centerline velocity peaks at 1.00 with perfect convex parabolic curvature. Zero phase lag with driving pressure gradient. Characteristic of microvascular arterioles.',
			color: '#06b6d4',
			colorFill: 'rgba(6,182,212,0.18)',
			maxLagDeg: 5
		},
		'4': {
			label: '&alpha; = 4.0',
			tag: 'Peak Center: 0.88 u_max &bull; Convex Arch',
			annotation: '<strong class="text-sky-400">[&alpha; = 4.0 &mdash; CONVEX BROADENED]:</strong> Unsteady inertia begins to damp peak acceleration. The profile remains smooth and convex across the whole diameter, but with broader shoulders and an attenuated center peak (0.88 u_max). Moderate phase lag (~35°). Characteristic of radial and tibial arteries.',
			color: '#38bdf8',
			colorFill: 'rgba(56,189,248,0.18)',
			maxLagDeg: 35
		},
		'7': {
			label: '&alpha; = 7.0',
			tag: 'Core Plateau: 0.755 u_max &bull; Plug-like',
			annotation: '<strong class="text-emerald-400">[&alpha; = 7.0 &mdash; PLUG-LIKE REGIME]:</strong> Inertia dominates the central core. Notice that the core is NOT a rigid flat line: it has a smooth, gentle plateau at 0.755 u_max with rounded shoulders that curve down to zero at the walls. Stokes layer compresses to &delta;/R &asymp; 0.20. Characteristic of femoral and common carotid arteries.',
			color: '#10b981',
			colorFill: 'rgba(16,185,129,0.18)',
			maxLagDeg: 55
		},
		'14': {
			label: '&alpha; = 14.0',
			tag: 'Center Dip: 0.645 | Peaks: 0.760 at &plusmn;0.76 R',
			annotation: '<strong class="text-amber-400">[&alpha; = 14.0 &mdash; CONCAVE INERTIAL DEPRESSION]:</strong> The core lags significantly behind the wall layers. The centerline velocity dips to 0.645 u_max in a smooth concave valley, while near-wall layers accelerate to twin rounded peaks of 0.760 u_max at r/R = &plusmn;0.76. Notice the smooth C1 rounded crests with zero sharp corners.',
			color: '#f59e0b',
			colorFill: 'rgba(245,158,11,0.18)',
			maxLagDeg: 75
		},
		'20': {
			label: '&alpha; = 20.0',
			tag: 'Center Valley: 0.525 | Peaks: 0.890 at &plusmn;0.84 R',
			annotation: '<strong class="text-rose-400">[&alpha; = 20.0 &mdash; RICHARDSON ANNULAR OVERSHOOT]:</strong> Classic M-shaped velocity profile. The fluid in the central core lags the driving pressure by ~85°, creating a deep concave depression (0.525 u_max). Near the vessel wall, fluid accelerates to two prominent rounded lobes peaking at 0.890 u_max at r/R = &plusmn;0.84. Thin Stokes boundary layer (&delta;/R &lt; 0.10). Characteristic of the aorta during exercise.',
			color: '#f43f5e',
			colorFill: 'rgba(244,63,94,0.18)',
			maxLagDeg: 86
		}
	};

	let currentAlpha = 1;
	let time = 0;

	// Button click handlers
	buttons.forEach(btn => {
		btn.addEventListener('click', () => {
			const alpha = parseInt(btn.getAttribute('data-alpha'), 10);
			if (isNaN(alpha)) return;
			currentAlpha = alpha;

			buttons.forEach(b => {
				b.classList.remove('active', 'bg-cyan-600', 'text-white', 'border-cyan-400/40');
				b.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
				const s = b.querySelector('span');
				if (s) { s.classList.remove('text-cyan-200'); s.classList.add('text-slate-500'); }
			});
			btn.classList.add('active', 'bg-cyan-600', 'text-white', 'border-cyan-400/40');
			btn.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
			const s = btn.querySelector('span');
			if (s) { s.classList.remove('text-slate-500'); s.classList.add('text-cyan-200'); }

			const r = regimes[String(alpha)] || regimes['1'];
			if (alphaDisplay) alphaDisplay.innerHTML = r.label;
			if (annotationEl) annotationEl.innerHTML = r.annotation;
			if (regimeTag) regimeTag.innerHTML = r.tag;
		});
	});

	/**
	 * Exact continuous, smooth envelope matching user's laboratory reference plot:
	 * rNorm: 0 (center) to 1 (wall)
	 */
	function getWomersleyEnvelope(rNorm, alpha) {
		if (alpha <= 1) {
			// Parabolic: 1.00 at center, 0 at wall
			return 1.00 * (1.0 - rNorm * rNorm);
		} else if (alpha <= 4) {
			// Convex arch: 0.88 at center, 0 at wall
			return 0.88 * (1.0 - 0.35 * (rNorm * rNorm) - 0.65 * Math.pow(rNorm, 3.5));
		} else if (alpha <= 7) {
			// Plug-like: 0.755 at center, slight curvature, smooth rounded flanks
			return 0.755 * (1.0 - 0.05 * (rNorm * rNorm) - 0.95 * Math.pow(rNorm, 6.0));
		} else if (alpha <= 14) {
			// Concave core: center = 0.645, rounded twin crests = 0.760 at rp = 0.76
			const center = 0.645;
			const peak = 0.760;
			const rp = 0.76;
			if (rNorm <= rp) {
				// Smooth concave bowl: zero derivative at 0 and rp
				return center + (peak - center) * (0.5 - 0.5 * Math.cos(Math.PI * rNorm / rp));
			} else {
				// Smooth quarter-cosine descent: zero derivative at rp, drops to 0 at wall
				const t = (rNorm - rp) / (1.0 - rp);
				return peak * Math.cos(0.5 * Math.PI * t);
			}
		} else {
			// alpha >= 20: Deep concave core 0.525, rounded twin crests = 0.890 at rp = 0.84
			const center = 0.525;
			const peak = 0.890;
			const rp = 0.84;
			if (rNorm <= rp) {
				// Smooth concave bowl: zero derivative at 0 and rp
				return center + (peak - center) * (0.5 - 0.5 * Math.cos(Math.PI * rNorm / rp));
			} else {
				// Smooth quarter-cosine descent: zero derivative at rp, drops to 0 at wall
				const t = (rNorm - rp) / (1.0 - rp);
				return peak * Math.cos(0.5 * Math.PI * t);
			}
		}
	}

	/**
	 * Dynamic time-resolved Womersley velocity:
	 * Accounts for realistic radial phase lag between the near-wall Stokes layer and sluggish inertial core.
	 */
	function womersleyVelocity(rNorm, alpha, phase) {
		const env = getWomersleyEnvelope(rNorm, alpha);
		const r = regimes[String(alpha)] || regimes['1'];
		const maxLagRad = (r.maxLagDeg * Math.PI) / 180;
		// Core lags the wall: phase lag is max at center (rNorm=0) and drops to 0 at wall (rNorm=1)
		const localLag = maxLagRad * (1.0 - rNorm * rNorm);
		return env * Math.cos(phase - localLag);
	}

	function renderProfile() {
		if (!canvas || !ctx) return;
		const W = canvas.width;
		const H = canvas.height;
		const dpr = window.devicePixelRatio || 1;

		// Clean canvas
		ctx.fillStyle = '#060b14';
		ctx.fillRect(0, 0, W, H);

		const rInfo = regimes[String(currentAlpha)] || regimes['1'];
		const mainColor = rInfo.color;

		// Layout margins
		const marginL = 85 * dpr;
		const marginR = 45 * dpr;
		const marginT = 45 * dpr;
		const marginB = 85 * dpr;
		const plotW = W - marginL - marginR;
		const plotH = H - marginT - marginB;
		const plotCX = marginL + plotW / 2; // zero velocity axis
		const plotTop = marginT;
		const plotBot = marginT + plotH;

		// Background grid lines
		ctx.strokeStyle = '#0f1d33';
		ctx.lineWidth = 1;
		for (let i = 0; i <= 10; i++) {
			const y = plotTop + (i / 10) * plotH;
			ctx.beginPath(); ctx.moveTo(marginL, y); ctx.lineTo(marginL + plotW, y); ctx.stroke();
		}
		for (let i = 0; i <= 10; i++) {
			const x = marginL + (i / 10) * plotW;
			ctx.beginPath(); ctx.moveTo(x, plotTop); ctx.lineTo(x, plotBot); ctx.stroke();
		}

		// Zero velocity center axis (u = 0)
		ctx.strokeStyle = '#1e293b';
		ctx.lineWidth = 1.5;
		ctx.setLineDash([4 * dpr, 4 * dpr]);
		ctx.beginPath();
		ctx.moveTo(plotCX, plotTop);
		ctx.lineTo(plotCX, plotBot);
		ctx.stroke();
		ctx.setLineDash([]);

		// Y-axis line
		ctx.strokeStyle = '#334155';
		ctx.beginPath();
		ctx.moveTo(marginL, plotTop);
		ctx.lineTo(marginL, plotBot);
		ctx.stroke();

		// Y-axis tick labels: radial position r/R from +1.0 to -1.0
		ctx.fillStyle = '#64748b';
		ctx.font = `${11 * dpr}px "JetBrains Mono", monospace`;
		ctx.textAlign = 'right';
		const ticks = ['+1.0 R (Wall)', '+0.5 R', '0.0 (Center)', '−0.5 R', '−1.0 R (Wall)'];
		for (let i = 0; i < 5; i++) {
			const y = plotTop + (i / 4) * plotH;
			ctx.fillText(ticks[i], marginL - 8 * dpr, y + 4 * dpr);
		}

		// X-axis velocity tick labels
		ctx.textAlign = 'center';
		ctx.fillText('−1.0', marginL + plotW * 0.12, plotBot + 20 * dpr);
		ctx.fillText('−0.5', marginL + plotW * 0.31, plotBot + 20 * dpr);
		ctx.fillText('0 (Rest)', plotCX, plotBot + 20 * dpr);
		ctx.fillText('+0.5', marginL + plotW * 0.69, plotBot + 20 * dpr);
		ctx.fillText('+1.0', marginL + plotW * 0.88, plotBot + 20 * dpr);

		// X-axis title
		ctx.fillStyle = '#94a3b8';
		ctx.font = `${10 * dpr}px "JetBrains Mono", monospace`;
		ctx.fillText('Axial Velocity  u(r, t) / u_max  [mm/s normalized]  →', plotCX, plotBot + 42 * dpr);

		// Y-axis title
		ctx.save();
		ctx.translate(16 * dpr, plotTop + plotH / 2);
		ctx.rotate(-Math.PI / 2);
		ctx.textAlign = 'center';
		ctx.fillText('Radial Position  r / R  →', 0, 0);
		ctx.restore();

		// Vessel wall visualization bands
		const wallBandH = 8 * dpr;
		ctx.fillStyle = 'rgba(56, 189, 248, 0.12)';
		ctx.fillRect(marginL, plotTop, plotW, wallBandH);
		ctx.fillRect(marginL, plotBot - wallBandH, plotW, wallBandH);
		ctx.strokeStyle = '#38bdf8';
		ctx.lineWidth = 1.5;
		ctx.beginPath();
		ctx.moveTo(marginL, plotTop + wallBandH);
		ctx.lineTo(marginL + plotW, plotTop + wallBandH);
		ctx.moveTo(marginL, plotBot - wallBandH);
		ctx.lineTo(marginL + plotW, plotBot - wallBandH);
		ctx.stroke();

		ctx.fillStyle = '#38bdf8';
		ctx.font = `bold ${9 * dpr}px "JetBrains Mono", monospace`;
		ctx.textAlign = 'left';
		ctx.fillText('NO-SLIP BOUNDARY (u = 0)', marginL + plotW + 8 * dpr, plotTop + 7 * dpr);
		ctx.fillText('NO-SLIP BOUNDARY (u = 0)', marginL + plotW + 8 * dpr, plotBot - 1 * dpr);

		// Current pulsatile phase
		const phase = time * 0.024;
		const phaseDeg = Math.round(((phase % (2 * Math.PI)) / (2 * Math.PI)) * 360);
		if (phaseLabel) {
			phaseLabel.innerHTML = 'Cardiac Phase: <strong class="text-white">' + phaseDeg + '°</strong>';
		}

		// 1. Ghost trails for phase continuity
		const nGhosts = 5;
		for (let g = nGhosts; g >= 1; g--) {
			const ghostPhase = phase - g * 0.28;
			const ghostAlpha = 0.03 + 0.02 * (nGhosts - g);
			ctx.strokeStyle = mainColor;
			ctx.globalAlpha = ghostAlpha;
			ctx.lineWidth = 1.2 * dpr;
			ctx.beginPath();
			const pts = 120;
			for (let i = 0; i <= pts; i++) {
				const rSigned = -1 + (2 * i / pts);
				const rNorm = Math.abs(rSigned);
				const vel = womersleyVelocity(rNorm, currentAlpha, ghostPhase);
				const x = plotCX + vel * (plotW * 0.38);
				const y = plotTop + ((1 - rSigned) / 2) * plotH;
				if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
			}
			ctx.stroke();
		}
		ctx.globalAlpha = 1.0;

		// 2. Main active velocity profile
		const pts = 240;
		const profilePoints = [];
		for (let i = 0; i <= pts; i++) {
			const rSigned = -1 + (2 * i / pts);
			const rNorm = Math.abs(rSigned);
			const vel = womersleyVelocity(rNorm, currentAlpha, phase);
			const x = plotCX + vel * (plotW * 0.38);
			const y = plotTop + ((1 - rSigned) / 2) * plotH;
			profilePoints.push({ x, y });
		}

		// Fill area between profile and zero line
		ctx.beginPath();
		ctx.moveTo(plotCX, plotTop);
		for (const p of profilePoints) ctx.lineTo(p.x, p.y);
		ctx.lineTo(plotCX, plotBot);
		ctx.closePath();
		ctx.fillStyle = rInfo.colorFill;
		ctx.fill();

		// Main outline stroke with glow
		ctx.beginPath();
		for (let i = 0; i < profilePoints.length; i++) {
			if (i === 0) ctx.moveTo(profilePoints[i].x, profilePoints[i].y);
			else ctx.lineTo(profilePoints[i].x, profilePoints[i].y);
		}
		ctx.strokeStyle = mainColor;
		ctx.lineWidth = 2.8 * dpr;
		ctx.shadowColor = mainColor;
		ctx.shadowBlur = 10 * dpr;
		ctx.stroke();
		ctx.shadowBlur = 0;

		// 3. Fluid velocity vector arrows at key radial stations
		const arrowRadii = [0.0, 0.20, 0.40, 0.60, 0.76, 0.84, 0.93];
		ctx.lineWidth = 1.4 * dpr;
		for (const rNorm of arrowRadii) {
			const vel = womersleyVelocity(rNorm, currentAlpha, phase);
			const arrowLen = vel * (plotW * 0.38);

			for (const sign of [-1, 1]) {
				if (rNorm === 0 && sign === -1) continue; // avoid duplicate center arrow
				const rSigned = sign * rNorm;
				const yPos = plotTop + ((1 - rSigned) / 2) * plotH;

				// Arrow shaft
				ctx.strokeStyle = mainColor;
				ctx.globalAlpha = 0.55;
				ctx.beginPath();
				ctx.moveTo(plotCX, yPos);
				ctx.lineTo(plotCX + arrowLen, yPos);
				ctx.stroke();

				// Arrow head
				if (Math.abs(arrowLen) > 5 * dpr) {
					const dir = arrowLen > 0 ? 1 : -1;
					const headX = plotCX + arrowLen;
					ctx.beginPath();
					ctx.moveTo(headX, yPos);
					ctx.lineTo(headX - dir * 6 * dpr, yPos - 3.5 * dpr);
					ctx.lineTo(headX - dir * 6 * dpr, yPos + 3.5 * dpr);
					ctx.closePath();
					ctx.fillStyle = mainColor;
					ctx.fill();
				}
				ctx.globalAlpha = 1.0;
			}
		}

		// 4. Pressure wave indicator at bottom
		const pwY = plotBot + 62 * dpr;
		ctx.strokeStyle = '#334155';
		ctx.lineWidth = 1;
		ctx.beginPath();
		ctx.moveTo(marginL, pwY);
		ctx.lineTo(marginL + plotW, pwY);
		ctx.stroke();

		ctx.strokeStyle = mainColor;
		ctx.lineWidth = 1.5 * dpr;
		ctx.shadowColor = mainColor;
		ctx.shadowBlur = 4 * dpr;
		ctx.beginPath();
		for (let x = marginL; x <= marginL + plotW; x++) {
			const xf = (x - marginL) / plotW;
			const pVal = Math.cos(phase - xf * Math.PI * 4) * 8 * dpr;
			if (x === marginL) ctx.moveTo(x, pwY + pVal);
			else ctx.lineTo(x, pwY + pVal);
		}
		ctx.stroke();
		ctx.shadowBlur = 0;

		ctx.fillStyle = '#64748b';
		ctx.font = `${9 * dpr}px "JetBrains Mono", monospace`;
		ctx.textAlign = 'left';
		ctx.fillText('∇P(t) = P₀ cos(ωt) &bull; Driving Pressure Waveform', marginL, pwY - 14 * dpr);

		// Phase clock top-right
		const ckX = W - 50 * dpr;
		const ckY = marginT + 26 * dpr;
		const ckR = 18 * dpr;
		ctx.strokeStyle = '#334155';
		ctx.lineWidth = 1.5;
		ctx.beginPath();
		ctx.arc(ckX, ckY, ckR, 0, Math.PI * 2);
		ctx.stroke();

		const hand = (phase % (Math.PI * 2)) - Math.PI / 2;
		ctx.strokeStyle = mainColor;
		ctx.lineWidth = 2 * dpr;
		ctx.beginPath();
		ctx.moveTo(ckX, ckY);
		ctx.lineTo(ckX + Math.cos(hand) * ckR * 0.75, ckY + Math.sin(hand) * ckR * 0.75);
		ctx.stroke();

		ctx.fillStyle = '#64748b';
		ctx.font = `${8 * dpr}px "JetBrains Mono", monospace`;
		ctx.textAlign = 'center';
		ctx.fillText('ωt', ckX, ckY + ckR + 12 * dpr);

		time += 1;
		requestAnimationFrame(renderProfile);
	}

	function resizeMain() {
		const rect = canvas.getBoundingClientRect();
		const dpr = window.devicePixelRatio || 1;
		if (rect.width > 0 && rect.height > 0) {
			canvas.width = rect.width * dpr;
			canvas.height = rect.height * dpr;
		}
	}
	window.addEventListener('resize', resizeMain);
	resizeMain();
	renderProfile();


	// ────────────────────────────────────────────────────────
	// 2. STATIC MATLAB-STYLE CHARTS
	// ────────────────────────────────────────────────────────
	function drawMatlabChart(canvasId, config) {
		const c = document.getElementById(canvasId);
		if (!c) return;
		const cx = c.getContext('2d');
		const rect = c.getBoundingClientRect();
		const dpr = window.devicePixelRatio || 1;
		c.width = rect.width * dpr;
		c.height = rect.height * dpr;
		const W = c.width, H = c.height;

		// Clean background
		cx.fillStyle = '#fafbfc';
		cx.fillRect(0, 0, W, H);

		const mL = 55 * dpr, mR = 20 * dpr, mT = 20 * dpr, mB = 35 * dpr;
		const pW = W - mL - mR, pH = H - mT - mB;

		// Grid lines
		cx.strokeStyle = '#e2e8f0';
		cx.lineWidth = 1;
		for (let i = 0; i <= 5; i++) {
			const y = mT + (i / 5) * pH;
			cx.beginPath(); cx.moveTo(mL, y); cx.lineTo(mL + pW, y); cx.stroke();
		}
		for (let i = 0; i <= 5; i++) {
			const x = mL + (i / 5) * pW;
			cx.beginPath(); cx.moveTo(x, mT); cx.lineTo(x, mT + pH); cx.stroke();
		}

		// Axes
		cx.strokeStyle = '#94a3b8';
		cx.lineWidth = 1.5;
		cx.beginPath(); cx.moveTo(mL, mT); cx.lineTo(mL, mT + pH); cx.lineTo(mL + pW, mT + pH); cx.stroke();

		// Tick labels
		cx.fillStyle = '#64748b';
		cx.font = `${10 * dpr}px "JetBrains Mono", monospace`;
		cx.textAlign = 'center';
		for (let i = 0; i <= 5; i++) {
			const x = mL + (i / 5) * pW;
			const val = config.xMin + (i / 5) * (config.xMax - config.xMin);
			cx.fillText(config.xFormat ? config.xFormat(val) : val.toFixed(0), x, mT + pH + 18 * dpr);
		}
		cx.textAlign = 'right';
		for (let i = 0; i <= 5; i++) {
			const y = mT + (i / 5) * pH;
			const val = config.yMax - (i / 5) * (config.yMax - config.yMin);
			cx.fillText(config.yFormat ? config.yFormat(val) : val.toFixed(1), mL - 6 * dpr, y + 4 * dpr);
		}

		// Axis titles
		cx.fillStyle = '#94a3b8';
		cx.font = `${9 * dpr}px "JetBrains Mono", monospace`;
		cx.textAlign = 'center';
		cx.fillText(config.xLabel, mL + pW / 2, mT + pH + 32 * dpr);

		cx.save();
		cx.translate(12 * dpr, mT + pH / 2);
		cx.rotate(-Math.PI / 2);
		cx.fillText(config.yLabel, 0, 0);
		cx.restore();

		// Curve lines
		config.series.forEach((s, idx) => {
			cx.strokeStyle = s.color;
			cx.lineWidth = 2.4 * dpr;
			cx.beginPath();
			let started = false;
			for (let px = 0; px <= pW; px++) {
				const xFrac = px / pW;
				const xVal = config.xMin + xFrac * (config.xMax - config.xMin);
				const yVal = s.fn(xVal);
				const yFrac = (yVal - config.yMin) / (config.yMax - config.yMin);
				const x = mL + px;
				const y = mT + pH - yFrac * pH;
				if (!started) { cx.moveTo(x, y); started = true; }
				else cx.lineTo(x, y);
			}
			cx.stroke();

			// Legend
			if (s.label) {
				cx.fillStyle = s.color;
				cx.beginPath();
				cx.arc(mL + pW - 10 * dpr, mT + 16 * dpr + idx * 16 * dpr, 4 * dpr, 0, Math.PI * 2);
				cx.fill();
				cx.fillStyle = '#475569';
				cx.font = `${9 * dpr}px "JetBrains Mono", monospace`;
				cx.textAlign = 'right';
				cx.fillText(s.label, mL + pW - 18 * dpr, mT + 20 * dpr + idx * 16 * dpr);
			}
		});

		// Markers
		if (config.markers) {
			config.markers.forEach(m => {
				const xFrac = (m.x - config.xMin) / (config.xMax - config.xMin);
				const yFrac = (m.y - config.yMin) / (config.yMax - config.yMin);
				const px = mL + xFrac * pW;
				const py = mT + pH - yFrac * pH;
				cx.beginPath();
				cx.arc(px, py, 5 * dpr, 0, Math.PI * 2);
				cx.fillStyle = m.color || '#f43f5e';
				cx.fill();
				cx.strokeStyle = '#fff';
				cx.lineWidth = 1.5;
				cx.stroke();
			});
		}
	}

	// Chart 1: WSS over one cycle for alpha = 1, 4, 7, 14, 20
	drawMatlabChart('wssChart', {
		xMin: 0, xMax: 360, yMin: -1.5, yMax: 1.5,
		xLabel: 'Phase (degrees)', yLabel: 'τ_w / τ_w,max',
		xFormat: v => v.toFixed(0) + '°',
		yFormat: v => v.toFixed(1),
		series: [
			{ label: 'α = 1.0', color: '#06b6d4', fn: x => Math.cos(x * Math.PI / 180) },
			{ label: 'α = 4.0', color: '#38bdf8', fn: x => 1.15 * Math.cos(x * Math.PI / 180 + 0.55) },
			{ label: 'α = 7.0', color: '#10b981', fn: x => 1.25 * Math.cos(x * Math.PI / 180 + 0.90) },
			{ label: 'α = 14.0', color: '#f59e0b', fn: x => 1.40 * Math.cos(x * Math.PI / 180 + 1.25) },
			{ label: 'α = 20.0', color: '#f43f5e', fn: x => 1.48 * Math.cos(x * Math.PI / 180 + 1.45) }
		]
	});

	// Chart 2: Boundary layer thickness vs alpha
	drawMatlabChart('blChart', {
		xMin: 0, xMax: 25, yMin: 0, yMax: 1.1,
		xLabel: 'Womersley Number α', yLabel: 'δ / R',
		xFormat: v => v.toFixed(0),
		yFormat: v => v.toFixed(1),
		series: [
			{ label: 'δ/R ≈ 1/α', color: '#06b6d4', fn: x => x < 0.3 ? 1.0 : Math.min(1.0, 1.0 / (0.5 + 0.5 * x)) }
		],
		markers: [
			{ x: 1, y: 1.00, color: '#06b6d4' },
			{ x: 4, y: 0.25, color: '#38bdf8' },
			{ x: 7, y: 0.14, color: '#10b981' },
			{ x: 14, y: 0.07, color: '#f59e0b' },
			{ x: 20, y: 0.05, color: '#f43f5e' }
		]
	});

	// Chart 3: Phase lag vs alpha
	drawMatlabChart('phaseChart', {
		xMin: 0, xMax: 25, yMin: 0, yMax: 95,
		xLabel: 'Womersley Number α', yLabel: 'Phase Lag φ (deg)',
		xFormat: v => v.toFixed(0),
		yFormat: v => v.toFixed(0) + '°',
		series: [
			{ label: 'Centerline lag', color: '#f43f5e', fn: x => (Math.atan2(x * x / 8, 1) / Math.PI * 180) }
		],
		markers: [
			{ x: 1, y: 5.0, color: '#06b6d4' },
			{ x: 4, y: 35.0, color: '#38bdf8' },
			{ x: 7, y: 55.0, color: '#10b981' },
			{ x: 14, y: 75.0, color: '#f59e0b' },
			{ x: 20, y: 86.0, color: '#f43f5e' }
		]
	});

	// Chart 4: Normalized flow rate vs alpha
	drawMatlabChart('flowChart', {
		xMin: 0, xMax: 25, yMin: 0, yMax: 1.1,
		xLabel: 'Womersley Number α', yLabel: '|Q| / |Q_Poiseuille|',
		xFormat: v => v.toFixed(0),
		yFormat: v => v.toFixed(1),
		series: [
			{ label: '|Q|/|Q_P|', color: '#10b981', fn: x => x < 0.1 ? 1.0 : 1.0 / Math.sqrt(1 + (x * x / 8) * (x * x / 8)) }
		],
		markers: [
			{ x: 1, y: 0.99, color: '#06b6d4' },
			{ x: 4, y: 0.45, color: '#38bdf8' },
			{ x: 7, y: 0.16, color: '#10b981' },
			{ x: 14, y: 0.04, color: '#f59e0b' },
			{ x: 20, y: 0.02, color: '#f43f5e' }
		]
	});

	// Resize static charts on window resize
	window.addEventListener('resize', () => {
		drawMatlabChart('wssChart', {
			xMin: 0, xMax: 360, yMin: -1.5, yMax: 1.5,
			xLabel: 'Phase (degrees)', yLabel: 'τ_w / τ_w,max',
			xFormat: v => v.toFixed(0) + '°', yFormat: v => v.toFixed(1),
			series: [
				{ label: 'α = 1.0', color: '#06b6d4', fn: x => Math.cos(x * Math.PI / 180) },
				{ label: 'α = 4.0', color: '#38bdf8', fn: x => 1.15 * Math.cos(x * Math.PI / 180 + 0.55) },
				{ label: 'α = 7.0', color: '#10b981', fn: x => 1.25 * Math.cos(x * Math.PI / 180 + 0.90) },
				{ label: 'α = 14.0', color: '#f59e0b', fn: x => 1.40 * Math.cos(x * Math.PI / 180 + 1.25) },
				{ label: 'α = 20.0', color: '#f43f5e', fn: x => 1.48 * Math.cos(x * Math.PI / 180 + 1.45) }
			]
		});
		drawMatlabChart('blChart', {
			xMin: 0, xMax: 25, yMin: 0, yMax: 1.1,
			xLabel: 'Womersley Number α', yLabel: 'δ / R',
			xFormat: v => v.toFixed(0), yFormat: v => v.toFixed(1),
			series: [{ label: 'δ/R ≈ 1/α', color: '#06b6d4', fn: x => x < 0.3 ? 1.0 : Math.min(1.0, 1.0 / (0.5 + 0.5 * x)) }],
			markers: [{ x: 1, y: 1.00, color: '#06b6d4' },{ x: 4, y: 0.25, color: '#38bdf8' },{ x: 7, y: 0.14, color: '#10b981' },{ x: 14, y: 0.07, color: '#f59e0b' },{ x: 20, y: 0.05, color: '#f43f5e' }]
		});
		drawMatlabChart('phaseChart', {
			xMin: 0, xMax: 25, yMin: 0, yMax: 95,
			xLabel: 'Womersley Number α', yLabel: 'Phase Lag φ (deg)',
			xFormat: v => v.toFixed(0), yFormat: v => v.toFixed(0) + '°',
			series: [{ label: 'Centerline lag', color: '#f43f5e', fn: x => (Math.atan2(x * x / 8, 1) / Math.PI * 180) }],
			markers: [{ x: 1, y: 5.0, color: '#06b6d4' },{ x: 4, y: 35.0, color: '#38bdf8' },{ x: 7, y: 55.0, color: '#10b981' },{ x: 14, y: 75.0, color: '#f59e0b' },{ x: 20, y: 86.0, color: '#f43f5e' }]
		});
		drawMatlabChart('flowChart', {
			xMin: 0, xMax: 25, yMin: 0, yMax: 1.1,
			xLabel: 'Womersley Number α', yLabel: '|Q| / |Q_Poiseuille|',
			xFormat: v => v.toFixed(0), yFormat: v => v.toFixed(1),
			series: [{ label: '|Q|/|Q_P|', color: '#10b981', fn: x => x < 0.1 ? 1.0 : 1.0 / Math.sqrt(1 + (x * x / 8) * (x * x / 8)) }],
			markers: [{ x: 1, y: 0.99, color: '#06b6d4' },{ x: 4, y: 0.45, color: '#38bdf8' },{ x: 7, y: 0.16, color: '#10b981' },{ x: 14, y: 0.04, color: '#f59e0b' },{ x: 20, y: 0.02, color: '#f43f5e' }]
		});
	});
})();
</script>
