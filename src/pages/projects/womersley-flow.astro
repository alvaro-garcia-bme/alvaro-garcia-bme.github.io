---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout activeTab="projects" title="Pulsatile Womersley Flow Simulation & Fluid Mechanics | Álvaro García Casas">

	<!-- Top Navigation Breadcrumb -->
	<div class="pt-8 pb-4">
		<a href="/projects" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#1a4478] hover:text-[#10172b] transition-colors">
			&larr; Back to Projects
		</a>
	</div>

	<!-- Header — Clean, Authoritative, Personal (no lab codes, no third-party names) -->
	<header class="pb-10 border-b border-[#10172b]/10">
		<div class="flex flex-wrap items-center gap-2 mb-3">
			<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#1a4478]/10 text-[#1a4478] uppercase tracking-wider">
				Computational Modeling &amp; Fluid Mechanics
			</span>
			<span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-slate-200 text-slate-700">
				Universidad Carlos III de Madrid
			</span>
			<span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-emerald-100 text-emerald-800">
				Bessel Navier-Stokes Solver
			</span>
		</div>

		<h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#10172b] tracking-tight leading-tight">
			Pulsatile Hemodynamics &amp; Womersley Flow Simulation
		</h1>

		<p class="mt-4 text-base sm:text-lg text-[#485569] max-w-4xl leading-relaxed">
			Numerical and analytical resolution of the unsteady Navier-Stokes equations for oscillatory blood flow in rigid cylindrical geometries. Evaluates how the Womersley dimensionless number (&alpha; = R&radic;(&omega;/&nu;)) governs the transition from classical parabolic Poiseuille flow to blunted plug flow and high-frequency annular velocity overshoot (Richardson annular effect), validated against benchtop pulsatile flow experimental tracking.
		</p>

		<div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-[#10172b]/10 text-xs text-[#485569]">
			<div class="flex items-center gap-4">
				<span><strong class="text-[#10172b]">Author &amp; Simulation Lead:</strong> Álvaro García Casas</span>
				<span><strong class="text-[#10172b]">Institution:</strong> Universidad Carlos III de Madrid</span>
			</div>
			<div class="flex flex-wrap gap-1.5">
				{['MATLAB R2024b', 'Complex Bessel (J₀)', 'Navier-Stokes Solvers', 'Fourier Spectral Decomposition', 'Particle Tracking Validation'].map(tool => (
					<span class="px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-700 font-mono text-[11px]">
						{tool}
					</span>
				))}
			</div>
		</div>
	</header>

	<!-- ═══════════════════════════════════════════════════════════════════
	     MAIN INTERACTIVE SIMULATOR: Womersley Radial Velocity Profile
	     ═══════════════════════════════════════════════════════════════════ -->
	<section class="py-8">
		<div class="bg-[#0b1220] rounded-2xl p-6 sm:p-8 text-white shadow-xl border border-slate-800">
			<!-- Header row -->
			<div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-5 border-b border-slate-800">
				<div>
					<div class="flex items-center gap-2">
						<span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
						<h2 class="text-lg font-bold uppercase tracking-wider text-slate-100">
							Dynamic Velocity Profile Monitor &bull; u(r, t)
						</h2>
					</div>
					<p class="text-xs text-slate-400 mt-1">
						Real-time solution of the unsteady momentum equation. Observe smooth profile morphing and wall shear deceleration across pulsatile cardiac phases.
					</p>
				</div>
				<div class="flex items-center gap-3">
					<span id="phaseLabel" class="bg-slate-800 px-3 py-1 rounded-lg text-xs font-mono text-cyan-300 border border-slate-700">
						Phase: <strong>0°</strong>
					</span>
					<div id="currentAlpha" class="text-3xl font-extrabold font-mono text-cyan-400">
						&alpha; = 1
					</div>
				</div>
			</div>

			<!-- Womersley regime buttons: Exactly corresponding to the empirical reference profiles -->
			<div class="flex flex-wrap gap-2.5 mt-5" id="alpha-controls">
				<button data-alpha="1" class="alpha-btn active px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-cyan-600 text-white border border-cyan-400/40">
					&alpha; = 1.0
					<span class="block text-[10px] font-normal text-cyan-200 mt-0.5">Parabolic (Poiseuille)</span>
				</button>
				<button data-alpha="4" class="alpha-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">
					&alpha; = 4.0
					<span class="block text-[10px] font-normal text-slate-500 mt-0.5">Convex Broadened</span>
				</button>
				<button data-alpha="7" class="alpha-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">
					&alpha; = 7.0
					<span class="block text-[10px] font-normal text-slate-500 mt-0.5">Plug-like (Carotid)</span>
				</button>
				<button data-alpha="14" class="alpha-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">
					&alpha; = 14.0
					<span class="block text-[10px] font-normal text-slate-500 mt-0.5">Concave Core / Twin Lobes</span>
				</button>
				<button data-alpha="20" class="alpha-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">
					&alpha; = 20.0
					<span class="block text-[10px] font-normal text-slate-500 mt-0.5">Annular Effect (M-Profile)</span>
				</button>
			</div>

			<!-- Canvas: 2D Radial Velocity Profile Plot -->
			<div class="mt-5 relative rounded-xl overflow-hidden bg-[#060b14] border border-slate-800">
				<!-- Top Status Overlay -->
				<div class="absolute top-3 left-4 right-4 z-10 flex items-center justify-between text-[11px] font-mono text-slate-400 pointer-events-none">
					<span class="text-cyan-400 font-bold flex items-center gap-1.5">
						<span class="w-2 h-2 rounded-full bg-cyan-400"></span> u(r, t) Radial Distribution &bull; Boundary Layer &delta;
					</span>
					<div class="flex items-center gap-3">
						<span id="regime-tag" class="text-slate-400 bg-slate-900/90 px-2 py-0.5 rounded border border-slate-800">
							Peak Center Velocity: <strong class="text-white">1.00 u_max</strong>
						</span>
					</div>
				</div>

				<canvas id="womersleyCanvas" width="960" height="520" class="w-full h-[420px] sm:h-[520px] block"></canvas>
			</div>

			<!-- Dynamic Regime Annotation Bar -->
			<div id="regime-annotation" class="mt-4 p-4 rounded-xl bg-slate-900/80 border border-slate-800 text-xs text-slate-300 leading-relaxed font-mono">
				<strong class="text-cyan-400">[&alpha; = 1.0 &mdash; VISCOUS PARABOLIC]:</strong> Quasi-steady flow. Viscous diffusion acts rapidly across the lumen. Centerline velocity peaks at 1.00 with perfect convex parabolic curvature. Zero phase lag with driving pressure gradient. Characteristic of microvascular arterioles.
			</div>
		</div>
	</section>

	<!-- Regime Overview Strip -->
	<section class="py-8 -mx-6 sm:-mx-10 px-6 sm:px-10 bg-[#10172b]">
		<div class="max-w-6xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
			<div>
				<div class="text-2xl sm:text-3xl font-extrabold text-cyan-400 font-mono">&alpha; &le; 1.0</div>
				<div class="text-xs text-slate-300 mt-1 font-semibold">Parabolic (Poiseuille)</div>
				<div class="text-[11px] text-slate-400 mt-0.5">Viscous-dominated, in-phase flow</div>
			</div>
			<div>
				<div class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-mono">&alpha; &asymp; 4–7</div>
				<div class="text-xs text-slate-300 mt-1 font-semibold">Plug-like Transition</div>
				<div class="text-[11px] text-slate-400 mt-0.5">Smooth shoulders, core blunting</div>
			</div>
			<div>
				<div class="text-2xl sm:text-3xl font-extrabold text-amber-400 font-mono">&alpha; &asymp; 14</div>
				<div class="text-xs text-slate-300 mt-1 font-semibold">Inertial Depression</div>
				<div class="text-[11px] text-slate-400 mt-0.5">Center dips to 0.65, dual peaks</div>
			</div>
			<div>
				<div class="text-2xl sm:text-3xl font-extrabold text-rose-400 font-mono">&alpha; &ge; 20</div>
				<div class="text-xs text-slate-300 mt-1 font-semibold">Annular Overshoot</div>
				<div class="text-[11px] text-slate-400 mt-0.5">Deep bowl (0.52), wall peaks (0.89)</div>
			</div>
		</div>
	</section>

	<!-- Section: The Physics of Pulsatile Flow -->
	<section class="py-14 border-b border-[#10172b]/10">
		<div class="max-w-4xl">
			<span class="text-xs font-bold uppercase tracking-wider text-[#1a4478]">Theoretical Hydrodynamics</span>
			<h2 class="text-2xl sm:text-3xl font-bold text-[#10172b] mt-1 mb-4">
				Fluid Mechanics: Transient Inertia vs. Viscous Shear
			</h2>
			<p class="text-sm sm:text-base text-[#485569] leading-relaxed mb-6">
				In cardiovascular hemodynamics, the heart drives flow via an oscillatory pressure gradient. The Womersley number (&alpha;) is the square root of the ratio between oscillatory inertial forces and viscous forces. It dictates how deeply wall friction penetrates into the vascular lumen over one cardiac cycle.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
			<div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
				<span class="text-xs font-bold uppercase tracking-wider text-[#1a4478] block mb-3">Womersley Parameter Formulation</span>
				<div class="bg-slate-50 p-5 rounded-xl border border-slate-100 text-center mb-4">
					<div class="text-xl font-bold font-mono text-[#10172b]">
						&alpha; = R &sdot; &radic;(&omega; / &nu;) = R &sdot; &radic;(2&pi;f &rho; / &mu;)
					</div>
					<div class="text-xs text-slate-500 mt-2">
						R = vessel radius &bull; &omega; = cardiac frequency &bull; &nu; = kinematic blood viscosity
					</div>
				</div>
				<p class="text-xs text-[#485569] leading-relaxed">
					When &alpha; is small (&lt; 2), momentum diffuses across the entire radius in a fraction of a cycle, preserving the classic parabolic Poiseuille shape. When &alpha; &gt; 10, the core fluid has too much inertia to respond synchronously to the pressure gradient, compressing viscous dissipation into a thin Stokes boundary layer of thickness &delta; &sim; R/&alpha;.
				</p>
			</div>

			<div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
				<span class="text-xs font-bold uppercase tracking-wider text-[#1a4478] block mb-3">Axisymmetric Navier-Stokes Equation</span>
				<div class="bg-slate-50 p-5 rounded-xl border border-slate-100 text-center mb-4">
					<div class="text-base font-bold font-mono text-[#10172b] leading-relaxed">
						&rho; &sdot; &part;u/&part;t = &minus;&part;P/&part;z + &mu; &sdot; (1/r) &sdot; &part;/&part;r(r &sdot; &part;u/&part;r)
					</div>
					<div class="text-xs text-slate-500 mt-2">
						Exact analytical solution via zeroth-order Bessel functions J₀(i<sup>3/2</sup>&alpha; &sdot; r/R)
					</div>
				</div>
				<p class="text-xs text-[#485569] leading-relaxed">
					Because Bessel functions of complex arguments introduce real and imaginary components, the resulting velocity u(r, t) undergoes a continuous phase lag across the radius. Near the vessel wall, low inertia allows the fluid to reverse direction almost immediately when the pressure gradient inverts, while the core continues gliding forward.
				</p>
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════════════════════════════════════════════
	     COMPUTATIONAL APPROACH: Highly Visual with MATLAB Plots & Validation
	     ═══════════════════════════════════════════════════════════════════ -->
	<section class="py-12 border-b border-[#10172b]/10">
		<div class="max-w-4xl mb-6">
			<span class="text-xs font-bold uppercase tracking-wider text-[#1a4478]">Numerical Methodology &amp; Benchtop Validation</span>
			<h2 class="text-2xl sm:text-3xl font-bold text-[#10172b] mt-1 mb-3">
				Computational Pipeline &amp; Experimental Validation
			</h2>
			<p class="text-sm sm:text-base text-[#485569] leading-relaxed">
				Resolution of the Womersley differential system in MATLAB using complex Bessel evaluation (<code class="font-mono bg-slate-100 px-1 py-0.5 rounded text-xs">besselj</code>), compared directly against experimental particle tracking in physical pulsatile flow channels.
			</p>
		</div>

		<!-- Physical Experimental Validation Showcase (From Laboratory Datasets) -->
		<div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-6 mb-8">
			<div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100">
				<div>
					<span class="text-xs font-bold uppercase tracking-wider text-[#1a4478]">Empirical Validation</span>
					<h3 class="text-base font-bold text-[#10172b] mt-0.5">Physical Pulsatile Channel Tracking vs. Numerical Profiles</h3>
				</div>
				<span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-blue-50 text-blue-700 border border-blue-200">
					Laboratory Particle Tracking DAQ
				</span>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<!-- Experimental Plot 1: Wo = 7.09 -->
				<div class="rounded-xl overflow-hidden bg-slate-50 border border-slate-200 p-3">
					<img 
						src="/images/projects/womersley-matlab-wo7.png" 
						alt="Empirical velocity profile tracking at Wo = 7.09, f = 0.5Hz" 
						class="w-full h-auto object-contain rounded-lg"
					/>
					<div class="mt-3 text-xs text-slate-600 leading-relaxed">
						<strong class="text-[#10172b]">Figure A &bull; Empirical Profile at Wo = 7.09 (f = 0.5 Hz):</strong> Discrete particle image displacement mapped across a &plusmn;4 mm tube diameter. Confirms smooth plug-like core blunting with steep velocity gradient within 1 mm of the wall.
					</div>
				</div>

				<!-- Experimental Plot 2: Wo = 14.18 -->
				<div class="rounded-xl overflow-hidden bg-slate-50 border border-slate-200 p-3">
					<img 
						src="/images/projects/womersley-matlab-wo14.png" 
						alt="Empirical velocity profile tracking at Wo = 14.18, f = 2.0Hz" 
						class="w-full h-auto object-contain rounded-lg"
					/>
					<div class="mt-3 text-xs text-slate-600 leading-relaxed">
						<strong class="text-[#10172b]">Figure B &bull; Empirical Profile at Wo = 14.18 (f = 2.0 Hz):</strong> Under elevated pulsation frequency, the experimental tracking clearly displays the characteristic velocity overshoot lobes near &plusmn;2.4 mm, validating the M-profile prediction.
					</div>
				</div>
			</div>
		</div>

		<!-- 4 MATLAB-Style Quantitative Hemodynamic Charts -->
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
			<!-- Chart 1: Wall Shear Stress over cycle -->
			<div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
				<div class="p-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
					<h3 class="text-xs font-bold uppercase tracking-wider text-[#10172b]">Wall Shear Stress &tau;<sub>w</sub>(t) Over Cardiac Cycle</h3>
					<span class="text-[10px] font-mono text-slate-400">MATLAB Analytical</span>
				</div>
				<div class="p-4">
					<canvas id="wssChart" width="500" height="260" class="w-full h-[240px] block"></canvas>
				</div>
				<div class="px-4 pb-4 text-[11px] text-slate-500 leading-relaxed">
					As &alpha; escalates, the wall shear stress exhibits a pronounced phase advance (up to 45&deg;) relative to the driving pressure gradient, resulting in elevated oscillatory shear index (OSI).
				</div>
			</div>

			<!-- Chart 2: Boundary layer thickness vs alpha -->
			<div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
				<div class="p-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
					<h3 class="text-xs font-bold uppercase tracking-wider text-[#10172b]">Stokes Boundary Layer Thickness &delta;/R vs &alpha;</h3>
					<span class="text-[10px] font-mono text-slate-400">&delta; &sim; R / &alpha;</span>
				</div>
				<div class="p-4">
					<canvas id="blChart" width="500" height="260" class="w-full h-[240px] block"></canvas>
				</div>
				<div class="px-4 pb-4 text-[11px] text-slate-500 leading-relaxed">
					The viscous penetration depth decays hyperbolically. For &alpha; &gt; 10, over 90% of the luminal cross-section behaves as an inviscid inertial plug.
				</div>
			</div>

			<!-- Chart 3: Phase lag vs alpha -->
			<div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
				<div class="p-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
					<h3 class="text-xs font-bold uppercase tracking-wider text-[#10172b]">Centerline Phase Lag &phi;<sub>center</sub> vs &alpha;</h3>
					<span class="text-[10px] font-mono text-slate-400">Phase Retardation</span>
				</div>
				<div class="p-4">
					<canvas id="phaseChart" width="500" height="260" class="w-full h-[240px] block"></canvas>
				</div>
				<div class="px-4 pb-4 text-[11px] text-slate-500 leading-relaxed">
					Fluid in the center requires substantial momentum transfer to accelerate. As &alpha; increases, centerline velocity lags the driving pressure wave by asymptotically approaching 90&deg;.
				</div>
			</div>

			<!-- Chart 4: Normalized flow rate amplitude -->
			<div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
				<div class="p-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
					<h3 class="text-xs font-bold uppercase tracking-wider text-[#10172b]">Oscillatory Flow Rate Attenuation |Q| / |Q<sub>Poiseuille</sub>|</h3>
					<span class="text-[10px] font-mono text-slate-400">Impedance Damping</span>
				</div>
				<div class="p-4">
					<canvas id="flowChart" width="500" height="260" class="w-full h-[240px] block"></canvas>
				</div>
				<div class="px-4 pb-4 text-[11px] text-slate-500 leading-relaxed">
					Rapid oscillation prevents full volumetric acceleration, causing vascular impedance to increase sharply with heart rate and vessel radius.
				</div>
			</div>
		</div>
	</section>

	<!-- Section: Quantitative Summary Table -->
	<section class="py-12 border-b border-[#10172b]/10">
		<div class="max-w-4xl mb-6">
			<span class="text-xs font-bold uppercase tracking-wider text-[#1a4478]">Regime Metrics</span>
			<h2 class="text-2xl sm:text-3xl font-bold text-[#10172b] mt-1 mb-3">
				Morphological &amp; Hemodynamic Characterization
			</h2>
		</div>

		<div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
			<div class="p-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
				<h3 class="text-xs font-bold uppercase tracking-wider text-[#10172b]">Womersley Number Spectrum &bull; Theoretical Values</h3>
				<span class="text-xs font-mono text-slate-500 font-semibold">Analytical Reference</span>
			</div>
			<div class="overflow-x-auto">
				<table class="w-full text-left text-xs font-mono">
					<thead class="bg-slate-100 text-slate-700 uppercase tracking-wider text-[11px] border-b border-slate-200">
						<tr>
							<th class="p-3.5">Womersley &alpha;</th>
							<th class="p-3.5">Center Value u(0)</th>
							<th class="p-3.5">Peak Value u_max</th>
							<th class="p-3.5">Peak Location r/R</th>
							<th class="p-3.5">Profile Curvature &amp; Morphology</th>
							<th class="p-3.5">Anatomical Site</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100 text-slate-600">
						<tr class="hover:bg-slate-50/80 transition-colors">
							<td class="p-3.5 font-bold text-cyan-600 font-sans">1.0</td>
							<td class="p-3.5 font-bold">1.00</td>
							<td class="p-3.5">1.00</td>
							<td class="p-3.5">0.00 (Center)</td>
							<td class="p-3.5 font-sans">Convex parabolic (Poiseuille)</td>
							<td class="p-3.5 font-sans text-slate-500">Terminal arterioles</td>
						</tr>
						<tr class="hover:bg-slate-50/80 transition-colors">
							<td class="p-3.5 font-bold text-sky-600 font-sans">4.0</td>
							<td class="p-3.5 font-bold">0.88</td>
							<td class="p-3.5">0.88</td>
							<td class="p-3.5">0.00 (Center)</td>
							<td class="p-3.5 font-sans">Convex arch with broader shoulders</td>
							<td class="p-3.5 font-sans text-slate-500">Radial / Tibial arteries</td>
						</tr>
						<tr class="hover:bg-slate-50/80 transition-colors">
							<td class="p-3.5 font-bold text-emerald-600 font-sans">7.0</td>
							<td class="p-3.5 font-bold">0.755</td>
							<td class="p-3.5">0.755</td>
							<td class="p-3.5">0.00 (Center)</td>
							<td class="p-3.5 font-sans">Plug-like: gentle plateau, rounded flanks</td>
							<td class="p-3.5 font-sans text-slate-500">Femoral / Brachial arteries</td>
						</tr>
						<tr class="hover:bg-slate-50/80 transition-colors">
							<td class="p-3.5 font-bold text-amber-600 font-sans">14.0</td>
							<td class="p-3.5 font-bold text-amber-600">0.645</td>
							<td class="p-3.5 font-bold">0.760</td>
							<td class="p-3.5">&plusmn;0.76</td>
							<td class="p-3.5 font-sans">Concave center bowl, twin rounded lobes</td>
							<td class="p-3.5 font-sans text-slate-500">Common Carotid artery</td>
						</tr>
						<tr class="hover:bg-slate-50/80 transition-colors">
							<td class="p-3.5 font-bold text-rose-600 font-sans">20.0</td>
							<td class="p-3.5 font-bold text-rose-600">0.525</td>
							<td class="p-3.5 font-bold text-rose-600">0.890</td>
							<td class="p-3.5">&plusmn;0.84</td>
							<td class="p-3.5 font-sans">Full M-profile (Richardson annular overshoot)</td>
							<td class="p-3.5 font-sans text-slate-500">Ascending Aorta (resting/exercise)</td>
