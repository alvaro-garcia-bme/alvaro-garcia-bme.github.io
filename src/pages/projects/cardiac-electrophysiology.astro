---
import MainLayout from '../../layouts/MainLayout.astro';

// Technical case study data
const metrics = [
	{ label: 'Young Adult Baseline (SI)', value: '5.61 m/s', detail: 'Optimal Clinical Reference (5–6 m/s)' },
	{ label: 'Late-Life Arterial Stiffness', value: '12.80 m/s', detail: '+128% vs young baseline (86-yr subject)' },
	{ label: 'Electromechanical Latency', value: '244 ms', detail: 'R-wave to distal finger pulse peak' },
	{ label: 'Cold Vasoconstriction Response', value: '-92.6%', detail: 'Pulse amplitude drop (1.604 → 0.119 mV)' },
];

const subjectData = [
	{ subject: 'Subject 1 (Young Adult)', age: '20', height: '1.56 m', si: '5.61 m/s', ri: '38.63%', bp: '95.8 / 60.9', hr: '69 bpm', rpp: '6,608', class: 'Optimal' },
	{ subject: 'Subject 2 (Pediatric Female)', age: '9', height: '1.27 m', si: '7.74 m/s', ri: '33.68%', bp: '82.5 / 60.0', hr: '77 bpm', rpp: '6,349', class: 'Hypotensive' },
	{ subject: 'Subject 3 (Middle-Aged Male)', age: '52', height: '1.85 m', si: '7.81 m/s', ri: '15.08%', bp: '115.7 / 73.6', hr: '65 bpm', rpp: '7,519', class: 'Optimal' },
	{ subject: 'Subject 4 (Geriatric Male)', age: '86', height: '1.83 m', si: '12.80 m/s', ri: '38.42%', bp: '130.8 / 82.8', hr: '64 bpm', rpp: '8,370', class: 'Prehypertensive' },
];

const stressResponses = [
	{ condition: 'Pre-Test Baseline', rr: '0.860 s', hr: '71 bpm', latency: '0.170 s', amp: '1.604 mV', state: 'Normothermic baseline' },
	{ condition: 'Cold Pressor (1 min)', rr: '0.865 s', hr: '68 bpm', latency: '0.275 s', amp: '0.119 mV', state: 'Sympathetic vasoconstriction' },
	{ condition: 'Cold Pressor (2 min)', rr: '0.790 s', hr: '77 bpm', latency: '0.260 s', amp: '0.184 mV', state: 'Sustained thermal defense' },
	{ condition: 'Rewarming (1 min)', rr: '0.815 s', hr: '75 bpm', latency: '0.235 s', amp: '1.330 mV', state: 'Reactive hyperemic rebound' },
	{ condition: 'Rewarming (2 min)', rr: '0.855 s', hr: '71 bpm', latency: '0.195 s', amp: '1.560 mV', state: 'Hemodynamic stabilization' },
	{ condition: 'Local Heat (2 min)', rr: '0.698 s', hr: '86 bpm', latency: '0.145 s', amp: '1.950 mV', state: 'Arteriolar vasodilation' },
];
---

<MainLayout activeTab="projects" title="Cardiovascular Electrophysiology & Arterial Hemodynamics | Álvaro García Casas">
	<!-- Top Navigation Breadcrumb -->
	<div class="pt-8 pb-4">
		<a href="/projects" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#1a4478] hover:text-[#10172b] transition-colors">
			&larr; Back to Engineering Projects
		</a>
	</div>

	<!-- Hero Header -->
	<header class="pb-10 border-b border-[#10172b]/10">
		<div class="flex flex-wrap items-center gap-2 mb-3">
			<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#1a4478]/10 text-[#1a4478] uppercase tracking-wider">
				Electrophysiology &amp; Vascular Biomechanics
			</span>
			<span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-slate-200 text-slate-700">
				Georgia Institute of Technology
			</span>
			<span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-emerald-100 text-emerald-800">
				In-Vivo Experimental Study
			</span>
		</div>

		<h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#10172b] tracking-tight leading-tight">
			Non-Invasive Cardiovascular Hemodynamics &amp; Electromechanical Profiling
		</h1>

		<p class="mt-4 text-base sm:text-lg text-[#485569] max-w-4xl leading-relaxed">
			A synchronized dual-channel investigation coupling thoracic Lead II electrocardiography (ECG) with digital infrared photoplethysmography (PPG). Quantified electromechanical pre-ejection latency, autonomic vasomotor thermoregulation, and age-dependent arterial stiffening across lifespan cohorts (ages 9–86) using pulse contour analysis and the Moens-Korteweg hydrodynamic formulation.
		</p>

		<!-- Authorship & Tools Summary -->
		<div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-[#10172b]/10 text-xs text-[#485569]">
			<div class="flex items-center gap-4">
				<span><strong class="text-[#10172b]">Lead Investigator:</strong> Álvaro García Casas</span>
				<span><strong class="text-[#10172b]">Affiliation:</strong> Georgia Institute of Technology</span>
			</div>
			<div class="flex flex-wrap gap-1.5">
				{['iWorx TA-ROAM', 'PPG-320 Plethysmograph', 'ECG Lead II', 'Pulse Wave Velocity', 'LabScribe', 'Matplotlib'].map(tool => (
					<span class="px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-700 font-mono text-[11px]">
						{tool}
					</span>
				))}
			</div>
		</div>
	</header>

	<!-- Key Metrics Strip -->
	<section class="py-10">
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			{metrics.map(m => (
				<div class="bg-white rounded-xl p-5 border border-slate-200 shadow-2xs">
					<span class="text-xs font-medium text-[#485569] uppercase tracking-wider block mb-1">
						{m.label}
					</span>
					<div class="text-2xl sm:text-3xl font-extrabold text-[#10172b] font-mono">
						{m.value}
					</div>
					<span class="text-xs text-slate-500 mt-2 block font-medium">
						{m.detail}
					</span>
				</div>
			))}
		</div>
	</section>

	<!-- Interactive Cardiovascular Waveform Monitor (Live Canvas Simulator) -->
	<section class="py-8">
		<div class="bg-[#0b1220] rounded-2xl p-6 sm:p-8 text-white shadow-xl border border-slate-800">
			<div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-6 border-b border-slate-800">
				<div>
					<div class="flex items-center gap-2">
						<span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
						<h2 class="text-lg font-bold uppercase tracking-wider text-slate-100">
							Synchronized Bio-Signal Monitor (ECG Lead II + Peripheral PPG)
						</h2>
					</div>
					<p class="text-xs text-slate-400 mt-1">
						Real-time visualization of myocardial electrical depolarization synchronized with digital infrared volumetric pulse arrival.
					</p>
				</div>

				<!-- Simulator Controls -->
				<div class="flex flex-wrap items-center gap-2" id="sim-controls">
					<button data-state="resting" class="sim-btn active px-3 py-1.5 rounded-lg text-xs font-bold font-mono transition-all bg-[#1a4478] text-white border border-cyan-400/30">
						Resting Baseline (71 bpm)
					</button>
					<button data-state="cold" class="sim-btn px-3 py-1.5 rounded-lg text-xs font-bold font-mono transition-all bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">
						Cold Pressor (Vasoconstriction)
					</button>
					<button data-state="heat" class="sim-btn px-3 py-1.5 rounded-lg text-xs font-bold font-mono transition-all bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">
						Hyperthermia (Vasodilation)
					</button>
					<button data-state="exercise" class="sim-btn px-3 py-1.5 rounded-lg text-xs font-bold font-mono transition-all bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">
						Post-Exertion (95 bpm)
					</button>
				</div>
			</div>

			<!-- Oscilloscope Screen -->
			<div class="mt-6 relative rounded-xl overflow-hidden bg-[#060b14] border border-slate-800">
				<!-- Channel Headers & Indicators -->
				<div class="absolute top-3 left-4 right-4 z-10 flex items-center justify-between text-[11px] font-mono text-slate-400 pointer-events-none">
					<div class="flex items-center gap-6">
						<span id="ch1-indicator" class="flex items-center gap-1.5 text-cyan-400 font-bold transition-colors duration-300">
							<span id="ch1-dot" class="w-2 h-2 rounded-full bg-cyan-400 transition-colors duration-300"></span> CH1: ECG Lead II (Thoracic ROAM) &bull; 1.0 mV/div
						</span>
						<span id="ch2-indicator" class="flex items-center gap-1.5 text-amber-400 font-bold transition-colors duration-300">
							<span id="ch2-dot" class="w-2 h-2 rounded-full bg-amber-400 transition-colors duration-300"></span> CH2: Digital Volume Pulse (PPG-320) &bull; 0.5 V/div
						</span>
					</div>
					<div class="hidden sm:flex items-center gap-3 text-slate-400">
						<span id="sim-rr-badge" class="bg-slate-800/80 px-2 py-0.5 rounded border border-slate-700 text-slate-300">
							RR Period: <strong id="sim-rr-val" class="text-cyan-400">845 ms</strong>
						</span>
						<span id="sim-latency-badge" class="bg-slate-800/80 px-2 py-0.5 rounded border border-slate-700 text-slate-300">
							R-to-Pulse Delay: <strong id="sim-latency-val" class="text-white">244 ms</strong>
						</span>
						<span id="sim-hr-badge" class="bg-slate-800/80 px-2 py-0.5 rounded border border-slate-700 text-slate-300">
							HR: <strong id="sim-hr-val" class="text-white">71 bpm</strong>
						</span>
					</div>
				</div>

				<canvas id="ecgCanvas" width="960" height="360" class="w-full h-[320px] sm:h-[360px] block"></canvas>
			</div>

			<!-- Dynamic Clinical Annotation Bar -->
			<div id="sim-explanation" class="mt-4 p-4 rounded-xl bg-slate-900/80 border border-slate-800 text-xs text-slate-300 leading-relaxed font-mono">
				<strong class="text-cyan-400">[BASELINE NORM]:</strong> Physiological resting state. R-R = 897 ms (71 bpm). Normal ventricular depolarization initiates myocardial contraction; the systolic arterial pulse arrives at the distal phalanx ~244 ms later. Dicrotic notch clearly distinguished during aortic valve closure.
			</div>
		</div>
	</section>

	<!-- Section 1: Acquisition Pipeline & Electrode Setup -->
	<section class="py-12 border-t border-[#10172b]/10">
		<div class="max-w-4xl">
			<span class="text-xs font-bold uppercase tracking-wider text-[#1a4478]">Phase 1 &bull; Bioinstrumentation Architecture</span>
			<h2 class="text-2xl sm:text-3xl font-bold text-[#10172b] mt-1 mb-4">
				Data Acquisition (DAQ) &amp; Sensor Telemetry
			</h2>
			<p class="text-sm sm:text-base text-[#485569] leading-relaxed mb-6">
				Biopotential recording in physiology labs is frequently contaminated by skeletal muscle motion artifacts and 60 Hz power-line interference. The experimental setup utilized the wireless <strong>iWorx TA-ROAM</strong> telemetry biopotential unit docked on an iWorx TA acquisition chassis, combined with an infrared transmission plethysmograph (PPG-320) on the finger.
			</p>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mt-6">
			<div class="lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
				<h3 class="text-sm font-bold uppercase tracking-wider text-[#10172b] mb-4">
					Electrode Configuration (Modified Lead II)
				</h3>
				<div class="rounded-xl overflow-hidden bg-slate-100 border border-slate-200 p-2 flex justify-center">
					<img 
						src="/images/projects/ecg-electrode-placement.png" 
						alt="Electrode placement for iWorx ROAM" 
						class="max-h-72 object-contain"
					/>
				</div>
				<p class="text-xs text-slate-500 mt-3 text-center">
					3-lead thoracic montage: Infraclavicular $(-)$, Left lower rib $(+)$, Sternal ground.
				</p>
			</div>

			<div class="lg:col-span-7 space-y-4">
				<div class="bg-white p-5 rounded-xl border border-slate-200">
					<h4 class="text-sm font-bold text-[#10172b] mb-1">1. Thoracic Vector Orientation</h4>
					<p class="text-xs sm:text-sm text-[#485569] leading-relaxed">
						The positive lead $(+)$ was placed on the left anterior chest below the pectoralis major and the negative lead $(-)$ at the right subclavicular fossa. This approximates the anatomical mean electrical axis of ventricular depolarization (Einthoven Lead II), maximizing the signal-to-noise ratio of the R-wave peak.
					</p>
				</div>

				<div class="bg-white p-5 rounded-xl border border-slate-200">
					<h4 class="text-sm font-bold text-[#10172b] mb-1">2. Optical Photoplethysmography (PPG-320)</h4>
					<p class="text-xs sm:text-sm text-[#485569] leading-relaxed">
						Fastened with velcro to the volar aspect of the distal segment of the left middle finger. It illuminates dermal capillary beds with near-infrared light and detects transmitted photodiode current, registering local blood volume expansions synchronously with central aortic ejections.
					</p>
				</div>

				<div class="bg-white p-5 rounded-xl border border-slate-200">
					<h4 class="text-sm font-bold text-[#10172b] mb-1">3. Signal Conditioning &amp; Pre-Processing</h4>
					<p class="text-xs sm:text-sm text-[#485569] leading-relaxed">
						Hardware bandpass filtering (0.05 Hz high-pass to eliminate respiration baseline wander, 100 Hz low-pass to eliminate high-frequency EMG noise) with an active 60 Hz notch filter. A continuous mathematical pulse integral transform was applied in LabScribe to reconstruct smooth pressure-analog volume pulses.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Section 2: Vasomotor Reactivity Under Cold & Heat Stress -->
	<section class="py-12 border-t border-[#10172b]/10">
		<div class="max-w-4xl mb-6">
			<span class="text-xs font-bold uppercase tracking-wider text-[#1a4478]">Phase 2 &bull; Autonomic Physiology</span>
			<h2 class="text-2xl sm:text-3xl font-bold text-[#10172b] mt-1 mb-3">
				Vasomotor Autonomic Reactivity: Thermal Stress Profiling
			</h2>
			<p class="text-sm sm:text-base text-[#485569] leading-relaxed">
				To characterize autonomic vascular regulation, the subject's left forearm was subjected to targeted acute localized cooling (ice water cold pressor) followed by rewarming and localized hyperthermia (heat pack). Pulse contour and propagation timing were logged continuously.
			</p>
		</div>

		<!-- Stress Table -->
		<div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
			<div class="p-5 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
				<h3 class="text-sm font-bold text-[#10172b]">
					Experimental Thermal Response Dataset (Subject 1: 20-yr Young Adult)
				</h3>
				<span class="text-xs font-mono text-slate-500 font-semibold">
					Empirical DAQ Telemetry
				</span>
			</div>
			<div class="overflow-x-auto">
				<table class="w-full text-left text-xs font-mono">
					<thead class="bg-slate-100 text-slate-700 uppercase tracking-wider text-[11px] border-b border-slate-200">
						<tr>
							<th class="p-3.5">Condition</th>
							<th class="p-3.5">R-R Interval</th>
							<th class="p-3.5">Heart Rate</th>
							<th class="p-3.5">R-Pulse Latency</th>
							<th class="p-3.5">Systolic Amplitude</th>
							<th class="p-3.5">Physiological Mechanism</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100 text-slate-600">
						{stressResponses.map(row => (
							<tr class="hover:bg-slate-50/80 transition-colors">
								<td class="p-3.5 font-bold text-[#10172b] font-sans">{row.condition}</td>
								<td class="p-3.5">{row.rr}</td>
								<td class="p-3.5 font-bold text-[#1a4478]">{row.hr}</td>
								<td class="p-3.5">{row.latency}</td>
								<td class="p-3.5 font-bold">{row.amp}</td>
								<td class="p-3.5 font-sans text-slate-500">{row.state}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<div class="p-4 bg-slate-50 border-t border-slate-100 text-xs text-slate-600 leading-relaxed">
				<strong>Key Finding:</strong> Localized hypothermia induced profound peripheral vasoconstriction, dropping pulse amplitude by <strong>92.6%</strong> (1.604 mV &rarr; 0.119 mV) and increasing transit latency from 0.170 s to 0.275 s due to increased vascular resistance. Rewarming produced reactive hyperemic vasodilation, while direct heating expanded vascular cross-section, accelerating propagation (latency dropped to 0.145 s) and elevating pulse amplitude to 1.950 mV.
			</div>
		</div>
	</section>

	<!-- Section 3: Biomechanical Pulse Contour Analysis & Arterial Stiffening -->
	<section class="py-12 border-t border-[#10172b]/10">
		<div class="max-w-4xl mb-8">
			<span class="text-xs font-bold uppercase tracking-wider text-[#1a4478]">Phase 3 &bull; Hemodynamic Biomechanics</span>
			<h2 class="text-2xl sm:text-3xl font-bold text-[#10172b] mt-1 mb-3">
				Arterial Aging: Stiffness Index (SI) &amp; Moens-Korteweg Modeling
			</h2>
			<p class="text-sm sm:text-base text-[#485569] leading-relaxed">
				Arterial compliance ($\Delta V / \Delta P$) acts as a hydraulic buffer (Windkessel effect), converting pulsatile left ventricular outflow into steady capillary perfusion. With aging, elastic fiber fragmentation and advanced glycation end-product (AGE) cross-linking of collagen elevate vessel wall stiffness. We quantified these alterations across four age groups using digital volume pulse contour analysis.
			</p>
		</div>

		<!-- Equations Grid -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
			<div class="bg-white p-5 rounded-xl border border-slate-200">
				<span class="text-xs font-bold uppercase tracking-wider text-[#1a4478] block mb-1">Stiffness Index (SI)</span>
				<div class="font-mono text-base font-bold text-[#10172b] my-2 bg-slate-50 p-2.5 rounded border border-slate-100 text-center">
					SI = Height (m) / &Delta;T<sub>refl</sub> (s)
				</div>
				<p class="text-xs text-slate-500">
					Estimates large artery pulse wave velocity by normalizing subject height over the transit time between forward and reflected waves.
				</p>
			</div>

			<div class="bg-white p-5 rounded-xl border border-slate-200">
				<span class="text-xs font-bold uppercase tracking-wider text-[#1a4478] block mb-1">Reflection Index (RI)</span>
				<div class="font-mono text-base font-bold text-[#10172b] my-2 bg-slate-50 p-2.5 rounded border border-slate-100 text-center">
					RI = (A<sub>diastolic</sub> / A<sub>systolic</sub>) &times; 100%
				</div>
				<p class="text-xs text-slate-500">
					Measures peripheral vascular tone. High RI indicates marked peripheral vasoconstriction; low RI reflects vascular relaxation.
				</p>
			</div>

			<div class="bg-white p-5 rounded-xl border border-slate-200">
				<span class="text-xs font-bold uppercase tracking-wider text-[#1a4478] block mb-1">Rate Pressure Product (RPP)</span>
				<div class="font-mono text-base font-bold text-[#10172b] my-2 bg-slate-50 p-2.5 rounded border border-slate-100 text-center">
					RPP = Heart Rate &times; Systolic BP
				</div>
				<p class="text-xs text-slate-500">
					Direct index of myocardial oxygen consumption (MVO<sub>2</sub>) and cardiac workload under differing vascular afterload.
				</p>
			</div>
		</div>

		<!-- Crucial Engineering Distinction Box -->
		<div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-xl mb-8">
			<h4 class="text-sm font-bold text-amber-950 mb-1 flex items-center gap-2">
				<span>&bull;</span> Critical Engineering Insight: Why R-Pulse Interval &ne; Pure Pulse Wave Velocity (PWV)
			</h4>
			<p class="text-xs sm:text-sm text-amber-900 leading-relaxed">
				Although the ECG R-wave marks ventricular depolarization and the PPG wave detects peripheral pulse arrival, their difference (R-Pulse interval) cannot be used directly as PWV. The interval incorporates the <strong>pre-ejection period (PEP, 50–80 ms)</strong> — the isovolumetric contraction time required for intraventricular pressure to exceed aortic pressure before the aortic valve leaflets open. True PWV requires differential measurement between two arterial transit points ($\Delta D / \Delta t$) or pulse contour reflection time analysis.
			</p>
		</div>

		<!-- Lifespan Dataset Table -->
		<div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden mb-12">
			<div class="p-5 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
				<h3 class="text-sm font-bold text-[#10172b]">
					Cross-Sectional Lifespan Dataset &amp; Cardiovascular Indices
				</h3>
				<span class="text-xs font-mono text-slate-500 font-semibold">
					JNC VI Classification
				</span>
			</div>
			<div class="overflow-x-auto">
				<table class="w-full text-left text-xs font-mono">
					<thead class="bg-slate-100 text-slate-700 uppercase tracking-wider text-[11px] border-b border-slate-200">
						<tr>
							<th class="p-3.5">Cohort Subject</th>
							<th class="p-3.5">Age</th>
							<th class="p-3.5">Height</th>
							<th class="p-3.5">Stiffness Index (SI)</th>
							<th class="p-3.5">Reflection Index (RI)</th>
							<th class="p-3.5">Blood Pressure</th>
							<th class="p-3.5">Heart Rate</th>
							<th class="p-3.5">RPP Workload</th>
							<th class="p-3.5">BP Status</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100 text-slate-600">
						{subjectData.map(s => (
							<tr class="hover:bg-slate-50/80 transition-colors">
								<td class="p-3.5 font-bold text-[#10172b] font-sans">{s.subject}</td>
								<td class="p-3.5">{s.age}</td>
								<td class="p-3.5">{s.height}</td>
								<td class="p-3.5 font-bold text-[#1a4478]">{s.si}</td>
								<td class="p-3.5 font-bold">{s.ri}</td>
								<td class="p-3.5">{s.bp}</td>
								<td class="p-3.5">{s.hr}</td>
								<td class="p-3.5 font-bold text-slate-900">{s.rpp}</td>
								<td class="p-3.5">
									<span class={`px-2 py-0.5 rounded font-sans text-[10px] font-bold ${
										s.class === 'Optimal' ? 'bg-emerald-100 text-emerald-800' :
										s.class === 'Hypotensive' ? 'bg-blue-100 text-blue-800' :
										'bg-amber-100 text-amber-800'
									}`}>
										{s.class}
									</span>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>

		<!-- Scientific Evidence Gallery: Publication Figures -->
		<div>
			<div class="mb-6">
				<span class="text-xs font-bold uppercase tracking-wider text-[#1a4478]">Phase 4 &bull; Quantitative Evidence</span>
				<h3 class="text-xl sm:text-2xl font-bold text-[#10172b] mt-1">
					Experimental Figures &amp; Matplotlib Analytics
				</h3>
				<p class="text-xs sm:text-sm text-[#485569] mt-1">
					Publication-ready figures generated from lab data illustrating the biophysical relationships between vascular stiffness, age progression, and myocardial demand.
				</p>
			</div>

