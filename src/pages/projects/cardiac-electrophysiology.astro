						<div class="lg:col-span-6 rounded-xl overflow-hidden bg-slate-50 border border-slate-200 p-2 flex justify-center">
							<img 
								src="/images/projects/ecg-arterial-aging-curve.png" 
								alt="Figure 2: Arterial Stiffness as a Function of Age" 
								class="max-h-80 w-auto object-contain rounded-lg"
							/>
						</div>
						<div class="lg:col-span-6">
							<div class="inline-block px-2.5 py-0.5 rounded text-[11px] font-mono font-bold bg-emerald-50 text-emerald-800 mb-2">
								Figure 2 &bull; Clinical Reference Calibration
