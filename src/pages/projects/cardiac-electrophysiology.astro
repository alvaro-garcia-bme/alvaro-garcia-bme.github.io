<!-- Client-side Script for Interactive Bio-Signal Oscilloscope Simulator -->
<script is:inline>
	const canvas = document.getElementById('ecgCanvas');
	const ctx = canvas ? canvas.getContext('2d') : null;
	const buttons = document.querySelectorAll('.sim-btn');
	const rrVal = document.getElementById('sim-rr-val');
	const latencyVal = document.getElementById('sim-latency-val');
	const hrVal = document.getElementById('sim-hr-val');
	const explanationEl = document.getElementById('sim-explanation');

	// Simulation states configuration
	const states = {
		resting: {
			hr: 71,
			rrMs: 845,
			latencyMs: 244,
			ppgAmp: 0.85,
			colorECG: '#00f2fe',
			colorPPG: '#fbbf24',
			explanation: '<strong class="text-cyan-400">[BASELINE NORM]:</strong> Physiological resting state. R-R = 845 ms (71 bpm). Normal ventricular depolarization initiates myocardial contraction; the systolic arterial pulse arrives at the distal phalanx ~244 ms later. Dicrotic notch clearly distinguished.'
		},
		cold: {
			hr: 68,
			rrMs: 882,
			latencyMs: 275,
			ppgAmp: 0.18, // Significant vasoconstriction attenuation (-92%)
			colorECG: '#38bdf8',
			colorPPG: '#60a5fa',
			explanation: '<strong class="text-blue-400">[COLD PRESSOR RESPONSE]:</strong> Acute thermoregulatory sympathetic vasoconstriction. Arteriolar luminal constriction dramatically attenuates peripheral pulse amplitude (-92.6%), while increased vascular resistance prolongs transit latency to 275 ms. Note the prolonged diastolic R-R interval (882 ms).'
		},
		heat: {
			hr: 86,
			rrMs: 698,
			latencyMs: 145,
			ppgAmp: 1.25, // Vasodilation expansion
			colorECG: '#f43f5e',
			colorPPG: '#f59e0b',
			explanation: '<strong class="text-amber-400">[HYPERTHERMIA / VASODILATION]:</strong> Local hyperthermic exposure relaxes vascular smooth muscle. Peripheral resistance drops, producing robust pulse wave amplitudes and accelerating wave propagation (latency drops to 145 ms; R-R interval compresses to 698 ms at 86 bpm).'
		},
		exercise: {
			hr: 95,
			rrMs: 631,
			latencyMs: 190,
			ppgAmp: 1.10,
			colorECG: '#ec4899',
			colorPPG: '#10b981',
			explanation: '<strong class="text-emerald-400">[POST-EXERTION TACHYCARDIA]:</strong> Elevated cardiac output. Notice that tachycardia is achieved almost entirely by shortening electrical diastole (T-P segment), compressing the R-R period to 631 ms, whereas electrical systole (P-T interval) remains tightly conserved.'
		}
	};

	let currentState = 'resting';
	let animId;
	let simTime = 0;
	let lastTimestamp = performance.now();

	// Smoothly animated target values
	let currentHR = 71;
	let currentLatency = 244;
	let currentPPGAmp = 0.85;

	// Switch state listener
	buttons.forEach(btn => {
		btn.addEventListener('click', () => {
			const targetState = btn.getAttribute('data-state');
			if (!targetState || !states[targetState]) return;
			currentState = targetState;

			buttons.forEach(b => {
				b.classList.remove('active', 'bg-[#1a4478]', 'text-white', 'border-cyan-400/30');
				b.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
			});
			btn.classList.add('active', 'bg-[#1a4478]', 'text-white', 'border-cyan-400/30');
			btn.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');

			const s = states[currentState];
			if (rrVal) rrVal.textContent = `${s.rrMs} ms`;
			if (latencyVal) latencyVal.textContent = `${s.latencyMs} ms`;
			if (hrVal) hrVal.textContent = `${s.hr} bpm`;
			if (explanationEl) explanationEl.innerHTML = s.explanation;
			updateIndicators(s);
		});
	});

	function updateIndicators(s) {
		const ch1Indicator = document.getElementById('ch1-indicator');
		const ch1Dot = document.getElementById('ch1-dot');
		const ch2Indicator = document.getElementById('ch2-indicator');
		const ch2Dot = document.getElementById('ch2-dot');
		if (ch1Indicator) ch1Indicator.style.color = s.colorECG;
		if (ch1Dot) ch1Dot.style.backgroundColor = s.colorECG;
		if (ch2Indicator) ch2Indicator.style.color = s.colorPPG;
		if (ch2Dot) ch2Dot.style.backgroundColor = s.colorPPG;
	}

	// Synthetic ECG waveform generator in absolute seconds
	// Ventricular depolarization (R peak) centered at t = 0.20s
	function getECGVoltage(cycleT) {
		let val = 0;
		// P wave: atrial depolarization (0.04s - 0.08s)
		const tP = 0.06;
		val += 0.16 * Math.exp(-Math.pow((cycleT - tP) / 0.024, 2));

		// Q wave: septal depolarization (0.16s - 0.175s)
		const tQ = 0.165;
		val -= 0.15 * Math.exp(-Math.pow((cycleT - tQ) / 0.010, 2));

		// R peak: ventricular depolarization (0.20s) -> 1.05 mV
		const tR = 0.20;
		val += 1.05 * Math.exp(-Math.pow((cycleT - tR) / 0.016, 2));

		// S wave: late ventricular depolarization (0.235s)
		const tS = 0.235;
		val -= 0.26 * Math.exp(-Math.pow((cycleT - tS) / 0.012, 2));

		// T wave: ventricular repolarization (0.38s)
		const tT = 0.38;
		val += 0.32 * Math.exp(-Math.pow((cycleT - tT) / 0.045, 2));

		// Diastolic isoelectric line: from 0.46s to T_period it remains flat 0.00 mV
		return val;
	}

	// Synthetic PPG pulse generator (Digital Volume Pulse in Volts)
	function getPPGVoltage(cycleT, latencyMs, ppgAmp, T) {
		const pulseOnset = 0.20 + (latencyMs / 1000);
		const ppgT = (((cycleT - pulseOnset) % T) + T) % T;
		let val = 0;

		if (ppgT >= 0 && ppgT <= 0.55) {
			// Systolic percussion wave (rapid ascending limb)
			const systolic = Math.sin(ppgT * Math.PI / 0.20) * Math.exp(-ppgT * 2.8);
			// Dicrotic notch reflection wave
			const dicrotic = ppgT > 0.18 ? 0.32 * Math.sin((ppgT - 0.18) * Math.PI / 0.16) * Math.exp(-(ppgT - 0.18) * 3.5) : 0;
			val = Math.max(0, systolic + dicrotic) * ppgAmp;
		}
		return val;
	}

	function render(now) {
		if (!canvas || !ctx) return;
		const dt = (now - lastTimestamp) / 1000;
		lastTimestamp = now;

		// Smooth interpolation towards selected state
		const target = states[currentState];
		currentHR += (target.hr - currentHR) * 0.06;
		currentLatency += (target.latencyMs - currentLatency) * 0.06;
		currentPPGAmp += (target.ppgAmp - currentPPGAmp) * 0.06;

		const T = 60 / currentHR; // Dynamic cardiac period in seconds (RR interval)

		const width = canvas.width;
		const height = canvas.height;

		// Background: Clinical digital phosphor monitor
		ctx.fillStyle = '#060b14';
		ctx.fillRect(0, 0, width, height);

		// Layout coordinates
		const leftMargin = 64;   // Space for Y-axis scale and tick labels
		const rightMargin = 16;
		const topMargin = 32;
		const bottomMargin = 28;
		const plotWidth = width - leftMargin - rightMargin;
		const plotHeight = height - topMargin - bottomMargin;

		// Display window: 4.0 seconds visible across the plot area
		const timeWindow = 4.0;
		const pxPerSec = plotWidth / timeWindow;

		// -------------------------------------------------------------
		// 1. Draw Calibrated Medical Coordinate Grid
		// -------------------------------------------------------------
		// Minor grid: 40 ms (0.04s) - standard ECG paper small square
		ctx.strokeStyle = '#0d1726';
		ctx.lineWidth = 0.8;
		const minorStepSec = 0.04;
		const minorStepPx = minorStepSec * pxPerSec;
		for (let x = leftMargin; x <= width - rightMargin; x += minorStepPx) {
			ctx.beginPath();
			ctx.moveTo(x, topMargin);
			ctx.lineTo(x, height - bottomMargin);
			ctx.stroke();
		}

		// Major grid: 200 ms (0.20s) - standard ECG paper large square
		ctx.strokeStyle = '#1a2942';
		ctx.lineWidth = 1.0;
		const majorStepSec = 0.20;
		const majorStepPx = majorStepSec * pxPerSec;
		for (let x = leftMargin; x <= width - rightMargin; x += majorStepPx) {
			ctx.beginPath();
			ctx.moveTo(x, topMargin);
			ctx.lineTo(x, height - bottomMargin);
			ctx.stroke();
		}

		// Horizontal grid lines across plot
		for (let y = topMargin; y <= height - bottomMargin; y += 22) {
			ctx.strokeStyle = '#0e1a2d';
			ctx.beginPath();
			ctx.moveTo(leftMargin, y);
			ctx.lineTo(width - rightMargin, y);
			ctx.stroke();
		}

		// Divider between CH1 (ECG) and CH2 (PPG)
		const midY = topMargin + (plotHeight * 0.50);
		ctx.strokeStyle = '#334155';
		ctx.setLineDash([4, 4]);
		ctx.beginPath();
		ctx.moveTo(leftMargin, midY);
		ctx.lineTo(width - rightMargin, midY);
		ctx.stroke();
		ctx.setLineDash([]);

		// -------------------------------------------------------------
		// 2. Draw Y-Axes, Voltage Scales & Calibration Indicators
		// -------------------------------------------------------------
		// Vertical axis boundary line
		ctx.strokeStyle = '#475569';
		ctx.lineWidth = 1.2;
		ctx.beginPath();
		ctx.moveTo(leftMargin, topMargin);
		ctx.lineTo(leftMargin, height - bottomMargin);
		ctx.stroke();

		// CH1: ECG Calibration & Ticks (Base at midY - 35, 1.0 mV = 60 px)
		const ecgBaseline = midY - 32;
		const ecgScale = 60; // 60 px = 1.0 mV

		ctx.font = '10px "JetBrains Mono", monospace';
		ctx.textAlign = 'right';
		ctx.textBaseline = 'middle';

		// ECG Ticks: +1.0 mV, +0.5 mV, 0.0 mV, -0.5 mV
		const ecgTicks = [
			{ v: 1.0, label: '+1.0 mV', color: target.colorECG },
			{ v: 0.5, label: '+0.5 mV', color: '#94a3b8' },
			{ v: 0.0, label: ' 0.0 mV', color: '#cbd5e1' },
			{ v: -0.5, label: '-0.5 mV', color: '#64748b' }
		];

		ecgTicks.forEach(t => {
			const yPos = ecgBaseline - (t.v * ecgScale);
			ctx.fillStyle = t.color;
			ctx.fillText(t.label, leftMargin - 6, yPos);
			// Axis tick mark
			ctx.strokeStyle = '#475569';
			ctx.beginPath();
			ctx.moveTo(leftMargin - 4, yPos);
			ctx.lineTo(leftMargin, yPos);
			ctx.stroke();
		});

		// Standard ECG 1.0 mV Calibration Pulse on Margin (10 mm = 1 mV, 200 ms wide)
		ctx.strokeStyle = target.colorECG;
		ctx.lineWidth = 1.5;
		ctx.beginPath();
		ctx.moveTo(12, ecgBaseline);
		ctx.lineTo(16, ecgBaseline);
		ctx.lineTo(16, ecgBaseline - ecgScale);
		ctx.lineTo(26, ecgBaseline - ecgScale);
		ctx.lineTo(26, ecgBaseline);
		ctx.lineTo(30, ecgBaseline);
		ctx.stroke();
		ctx.fillStyle = target.colorECG;
		ctx.fillText('1 mV', 24, ecgBaseline - ecgScale - 8);

		// CH2: PPG Calibration & Ticks (Base at height - bottomMargin - 18, 1.0 V = 80 px)
		const ppgBaseline = height - bottomMargin - 20;
		const ppgScale = 75; // 75 px = 1.0 V

		const ppgTicks = [
			{ v: 1.0, label: '+1.0 V', color: target.colorPPG },
			{ v: 0.5, label: '+0.5 V', color: '#94a3b8' },
			{ v: 0.0, label: ' 0.0 V', color: '#cbd5e1' }
		];

		ppgTicks.forEach(t => {
			const yPos = ppgBaseline - (t.v * ppgScale);
			ctx.fillStyle = t.color;
			ctx.fillText(t.label, leftMargin - 6, yPos);
			// Axis tick mark
			ctx.strokeStyle = '#475569';
			ctx.beginPath();
			ctx.moveTo(leftMargin - 4, yPos);
			ctx.lineTo(leftMargin, yPos);
			ctx.stroke();
		});

		// -------------------------------------------------------------
		// 3. Draw Bottom Horizontal Time Axis (Seconds)
		// -------------------------------------------------------------
		const timeAxisY = height - bottomMargin;
		ctx.strokeStyle = '#475569';
		ctx.lineWidth = 1.2;
		ctx.beginPath();
		ctx.moveTo(leftMargin, timeAxisY);
		ctx.lineTo(width - rightMargin, timeAxisY);
		ctx.stroke();

		ctx.textAlign = 'center';
		ctx.textBaseline = 'top';

		// Time tick marks every 0.5 seconds
		for (let sec = 0.0; sec <= timeWindow; sec += 0.5) {
			const xPos = leftMargin + (sec * pxPerSec);
			ctx.strokeStyle = '#64748b';
			ctx.beginPath();
			ctx.moveTo(xPos, timeAxisY);
			ctx.lineTo(xPos, timeAxisY + 5);
			ctx.stroke();

			ctx.fillStyle = '#94a3b8';
			ctx.font = '10px "JetBrains Mono", monospace';
			ctx.fillText(`${sec.toFixed(1)}s`, xPos, timeAxisY + 7);
		}

		// Centered Time Axis Caption
		ctx.textAlign = 'left';
		ctx.fillStyle = '#64748b';
		ctx.fillText('Horizontal Time Scale (25 mm/s sweep • 1 div = 0.20 s)', leftMargin + 8, topMargin - 18);

		// Dynamic Calibration Indicator in Right Corner
		ctx.textAlign = 'right';
		ctx.fillStyle = '#38bdf8';
		ctx.fillText(`RR = ${Math.round(T * 1000)} ms • HR = ${Math.round(currentHR)} bpm`, width - rightMargin, topMargin - 18);

		// -------------------------------------------------------------
		// 4. Render CH1: ECG Lead II Waveform (Dynamic Period T)
		// -------------------------------------------------------------
		ctx.strokeStyle = target.colorECG;
		ctx.lineWidth = 2.2;
		ctx.shadowColor = target.colorECG;
		ctx.shadowBlur = 7;
		ctx.beginPath();

		for (let x = leftMargin; x <= width - rightMargin; x++) {
			const tAbs = ((x - leftMargin) / pxPerSec) - simTime;
			const cycleT = ((tAbs % T) + T) % T; // Position within cardiac period [0, T)
			const ecgVoltage = getECGVoltage(cycleT);
			const y = ecgBaseline - (ecgVoltage * ecgScale);

			if (x === leftMargin) ctx.moveTo(x, y);
			else ctx.lineTo(x, y);
		}
		ctx.stroke();

		// -------------------------------------------------------------
		// 5. Render CH2: PPG Finger Pulse Waveform (Dynamic Latency & Period)
		// -------------------------------------------------------------
		ctx.strokeStyle = target.colorPPG;
		ctx.lineWidth = 2.4;
		ctx.shadowColor = target.colorPPG;
		ctx.shadowBlur = 7;
		ctx.beginPath();

		for (let x = leftMargin; x <= width - rightMargin; x++) {
			const tAbs = ((x - leftMargin) / pxPerSec) - simTime;
			const cycleT = ((tAbs % T) + T) % T;
			const ppgVoltage = getPPGVoltage(cycleT, currentLatency, currentPPGAmp, T);
			const y = ppgBaseline - (ppgVoltage * ppgScale);

			if (x === leftMargin) ctx.moveTo(x, y);
			else ctx.lineTo(x, y);
		}
		ctx.stroke();

		ctx.shadowBlur = 0; // Reset glow

		// Advance simulation time (real-time sweep calibrated to 1 sec / sec)
		simTime += 0.007;

		animId = requestAnimationFrame(render);
	}

	function resize() {
		if (!canvas) return;
		const rect = canvas.getBoundingClientRect();
		if (rect.width > 0) {
			const dpr = window.devicePixelRatio || 1;
			canvas.width = Math.round(rect.width * dpr);
			canvas.height = Math.round(rect.height * dpr);
		}
	}

	window.addEventListener('resize', resize);
	resize();
	animId = requestAnimationFrame(render);
</script>
