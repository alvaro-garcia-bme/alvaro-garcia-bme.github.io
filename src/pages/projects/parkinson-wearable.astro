	{ id: 'Patient 06 (P06)', emgLow: '509.70 mV', emgHigh: '511.50 mV', emgDelta: '+1.80 mV', gsrLow: '470.60 mV', gsrHigh: '223.00 mV', gsrDelta: '-247.60 mV' },
