					<text x="195" y="118" fill="#3b82f6" font-size="8" font-family="monospace" text-anchor="middle">Pre-Amplifier</text>
					<text x="166" y="84" fill="#1e3a8a" font-size="11" font-family="monospace">-</text>
					<text x="166" y="144" fill="#1e3a8a" font-size="11" font-family="monospace">+</text>

					<!-- In-Amp Power Pins -->
					<path d="M 205 82 L 205 68" stroke="#dc2626" stroke-width="1.2" fill="none"/>
					<text x="205" y="63" fill="#dc2626" font-size="8" font-family="monospace" text-anchor="middle">+5V</text>
					<path d="M 205 137 L 205 150" stroke="#64748b" stroke-width="1.2" fill="none"/>
					<line x1="200" y1="150" x2="210" y2="150" stroke="#64748b" stroke-width="1.5"/>

					<!-- Output line from In-Amp to Inter-Stage Coupling -->
					<path d="M 250 110 L 310 110" stroke="#1e3a8a" stroke-width="1.8" fill="none"/>

					<!-- Resistor R4 (Unified Navy Blue) -->
					<rect x="310" y="104" width="30" height="12" fill="#eff6ff" stroke="#1e3a8a" stroke-width="1.6" rx="2"/>
					<text x="325" y="113" fill="#1e3a8a" font-size="8" font-family="monospace" text-anchor="middle">R4</text>
					<path d="M 340 110 L 375 110" stroke="#1e3a8a" stroke-width="1.8" fill="none"/>

					<!-- Capacitor C1 (10 uF DC Half-Cell Blocker - Unified Navy Blue) -->
