					<path d="M 495 75 L 510 75" stroke="#1e3a8a" stroke-width="1.5" fill="none"/>
					<circle cx="510" cy="127" r="3" fill="#1e3a8a"/>

					<!-- Output to ADC A0 -->
					<path d="M 530 127 L 680 127" stroke="#1e3a8a" stroke-width="2" fill="none"/>
