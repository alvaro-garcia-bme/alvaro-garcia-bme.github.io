<MainLayout activeTab="projects" title="Continuous Forearm Wearable Cuff: Tremor & Autonomic Stress Biomarkers | Álvaro García Casas">
	<!-- Top Navigation Breadcrumb -->
	<div class="pt-8 pb-4">
		<a href="/projects" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#1e3a8a] hover:text-[#0f172a] transition-colors">
			&larr; Back to Engineering Projects
		</a>
	</div>

	<!-- Hero Header (Clean Light Theme) -->
	<header class="pb-10 border-b border-slate-200">
		<div class="flex flex-wrap items-center gap-2 mb-3">
			<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-[#1e3a8a] border border-blue-200/60 uppercase tracking-wider">
				Wearable Biomedical Systems &amp; Instrumentation
			</span>
			<span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-slate-100 text-slate-700 border border-slate-200">
				Georgia Institute of Technology
			</span>
			<span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
				Completed &bull; 10 Patients (p &lt; 0.05)
			</span>
		</div>

		<h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
			Continuous Forearm Wearable Cuff: Quantitative Tremor &amp; Autonomic Stress Biomarkers
		</h1>

		<p class="mt-4 text-base sm:text-lg text-slate-600 max-w-4xl leading-relaxed">
			Design, bioinstrumentation, and clinical validation of a continuous forearm sensor cuff integrating surface electromyography (sEMG) with galvanic skin response (GSR / electrodermal impedance). Quantifies the impact of acute sympathetic arousal on pathological neurogenic tremor across 10 patients (5 trials each), demonstrating statistically significant inverse correlation (<span class="font-mono font-bold text-slate-900">p = 0.041, R² = 0.4266</span>).
		</p>

		<!-- Authorship & Tools Summary -->
		<div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-slate-200 text-xs text-slate-600">
			<div class="flex items-center gap-4">
				<span><strong class="text-slate-900">Lead Engineer:</strong> Álvaro García Casas</span>
				<span><strong class="text-slate-900">Affiliation:</strong> Georgia Institute of Technology</span>
			</div>
			<div class="flex flex-wrap gap-1.5">
				{['Wearable Cuff', 'Surface EMG (sEMG)', 'Galvanic Skin Response (GSR)', 'Instrumentation Amplifier', 'Active 60 Hz Notch Filter', 'Low-Pass Filter (LPF)', 'Transimpedance Bridge', 'Decoupled DAQ Telemetry', 'Real-Time MATLAB DSP'].map(tool => (
					<span class="px-2.5 py-0.5 rounded-md bg-slate-50 border border-slate-200 text-slate-700 font-mono text-[11px]">
						{tool}
					</span>
				))}
			</div>
		</div>
	</header>

	<!-- Key Metrics Strip -->
	<section class="py-8">
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			{metrics.map(m => (
				<div class="bg-white rounded-xl p-5 border border-slate-200 shadow-2xs hover:border-slate-300 transition-colors">
					<span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-1">
						{m.label}
					</span>
					<div class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-mono" set:html={m.value}></div>
					<span class="text-xs text-slate-500 mt-2 block leading-normal">
						{m.detail}
					</span>
				</div>
			))}
		</div>
	</section>

	<!-- SECTION 1: COMPLETE DUAL-CHANNEL HARDWARE SCHEMATIC (sEMG + GSR) -->
	<section class="py-8">
		<div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-xs">
			<div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-6 border-b border-slate-200">
				<div>
					<div class="flex items-center gap-2">
						<span class="w-2.5 h-2.5 rounded-full bg-[#1e3a8a]"></span>
						<h2 class="text-lg font-bold text-slate-900 tracking-tight">
							Dual-Channel Analog Front-End (AFE) Circuit Schematic
						</h2>
					</div>
					<p class="text-xs text-slate-500 mt-1">
						Integrated biopotential &amp; galvanic conditioning circuit. sEMG channel (Navy Blue) and GSR channel (Warm Amber) with fully coupled signal lines and zero floating terminals.
					</p>
				</div>
				<div class="flex items-center gap-2">
					<span class="text-[11px] font-mono font-semibold px-3 py-1 rounded-full bg-blue-50 text-[#1e3a8a] border border-blue-200">
						IEEE 315 &bull; Hardware Schematic
					</span>
				</div>
			</div>

			<!-- Vector Schematic Canvas (Clean Slate Technical Blueprint) -->
			<div class="mt-6 bg-slate-50/75 rounded-xl p-4 sm:p-6 border border-slate-200 overflow-x-auto">
				<svg viewBox="0 0 940 440" class="w-full h-auto min-w-[760px] select-none" id="dual-schematic-svg">
					<defs>
						<pattern id="clean-grid" width="20" height="20" patternUnits="userSpaceOnUse">
							<path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e2e8f0" stroke-width="0.8"/>
						</pattern>
					</defs>
					<rect width="940" height="440" fill="url(#clean-grid)" rx="8"/>

					<!-- ============================================================== -->
					<!-- CHANNEL 1: sEMG BIOPOTENTIAL CHAIN (TOP HALF - UNIFIED NAVY BLUE) -->
					<!-- ============================================================== -->
					<text x="35" y="30" fill="#1e3a8a" font-size="11" font-family="monospace" font-weight="bold" letter-spacing="0.5">
						CHANNEL 1: sEMG BIOPOTENTIAL AMPLIFICATION &amp; ACTIVE BANDPASS
					</text>

					<!-- Forearm Electrodes -->
					<!-- Bio- Lead -->
					<circle cx="50" cy="80" r="10" fill="#eff6ff" stroke="#1e3a8a" stroke-width="2"/>
					<text x="50" y="84" fill="#1e3a8a" font-size="11" font-family="monospace" text-anchor="middle" font-weight="bold">-</text>
					<text x="50" y="62" fill="#475569" font-size="9" font-family="monospace" text-anchor="middle">Bio- (Distal)</text>

					<!-- Bio+ Lead -->
					<circle cx="50" cy="140" r="10" fill="#eff6ff" stroke="#1e3a8a" stroke-width="2"/>
					<text x="50" y="144" fill="#1e3a8a" font-size="11" font-family="monospace" text-anchor="middle" font-weight="bold">+</text>
					<text x="50" y="162" fill="#475569" font-size="9" font-family="monospace" text-anchor="middle">Bio+ (Medial)</text>

					<!-- Elbow Ground Reference -->
					<circle cx="50" cy="195" r="7" fill="#ffffff" stroke="#64748b" stroke-width="1.8"/>
					<text x="50" y="212" fill="#64748b" font-size="8" font-family="monospace" text-anchor="middle">Elbow GND</text>

					<!-- Ground Bus wire -->
					<path d="M 57 195 L 115 195 L 115 178" stroke="#64748b" stroke-width="1.5" fill="none"/>
