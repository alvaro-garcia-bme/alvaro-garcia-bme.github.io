					<line x1="113" y1="186" x2="117" y2="186" stroke="#64748b" stroke-width="1"/>

					<!-- Continuous Wires from Electrodes to In-Amp Inputs -->
					<path d="M 60 80 L 160 80" stroke="#1e3a8a" stroke-width="1.8" fill="none"/>
					<path d="M 60 140 L 160 140" stroke="#1e3a8a" stroke-width="1.8" fill="none"/>

					<!-- Gain Resistor R3 (120 Ohm) - FULLY TIED TO IN-AMP GAIN PINS (ZERO FLOATING) -->
					<!-- Top Gain Pin connection from In-Amp pin at (160, 68) -->
					<path d="M 160 68 L 130 68 L 130 88" stroke="#1e3a8a" stroke-width="1.6" fill="none"/>
