					<text x="112" y="108" fill="#1e3a8a" font-size="8" font-family="monospace" text-anchor="end">120&Omega;</text>
					<!-- Bottom Gain Pin connection into In-Amp pin at (160, 152) -->
					<path d="M 130 122 L 130 152 L 160 152" stroke="#1e3a8a" stroke-width="1.6" fill="none"/>
					<circle cx="160" cy="152" r="2.5" fill="#1e3a8a"/>

					<!-- U1: Instrumentation Amplifier Body -->
