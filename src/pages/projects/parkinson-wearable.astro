					<path d="M 415 187 L 415 195" stroke="#dc2626" stroke-width="1.2" fill="none"/>
					<text x="415" y="204" fill="#dc2626" font-size="8" font-family="monospace" text-anchor="middle">+5V</text>

					<!-- R2 to GND (Centered text inside resistor box) -->
					<rect x="360" y="138" width="24" height="14" fill="#eff6ff" stroke="#1e3a8a" stroke-width="1.4" rx="2"/>
					<text x="372" y="148" fill="#1e3a8a" font-size="8" font-family="monospace" text-anchor="middle" font-weight="bold">R2</text>
					<path d="M 360 145 L 345 145 L 345 160" stroke="#64748b" stroke-width="1.2" fill="none"/>
					<line x1="340" y1="160" x2="350" y2="160" stroke="#64748b" stroke-width="1.5"/>
					<path d="M 384 145 L 415 145" stroke="#1e3a8a" stroke-width="1.5" fill="none"/>

					<!-- U2: Active Notch & LPF Filter Body -->
					<polygon points="440,85 440,170 530,127" fill="#eff6ff" stroke="#1e3a8a" stroke-width="2.2"/>
					<text x="474" y="122" fill="#1e3a8a" font-size="10" font-family="monospace" font-weight="bold" text-anchor="middle">NOTCH &amp; LPF</text>
					<text x="474" y="135" fill="#3b82f6" font-size="8" font-family="monospace" text-anchor="middle">Active Filter</text>
					<text x="446" y="114" fill="#1e3a8a" font-size="11" font-family="monospace">-</text>
					<text x="446" y="149" fill="#1e3a8a" font-size="11" font-family="monospace">+</text>

					<!-- Feedback Network (R5 & C2 in parallel, clean orthogonal connections) -->
					<circle cx="420" cy="110" r="3" fill="#1e3a8a"/>
					<path d="M 420 110 L 420 55 L 450 55" stroke="#1e3a8a" stroke-width="1.5" fill="none"/>
					<!-- R5 Resistor -->
					<rect x="450" y="49" width="34" height="12" fill="#eff6ff" stroke="#1e3a8a" stroke-width="1.5" rx="2"/>
					<text x="467" y="58" fill="#1e3a8a" font-size="8" font-family="monospace" text-anchor="middle">R5</text>
					<!-- C2 Capacitor -->
					<path d="M 420 75 L 454 75" stroke="#1e3a8a" stroke-width="1.5" fill="none"/>
					<line x1="454" y1="69" x2="454" y2="81" stroke="#1e3a8a" stroke-width="2"/>
					<line x1="459" y1="69" x2="459" y2="81" stroke="#1e3a8a" stroke-width="2"/>
