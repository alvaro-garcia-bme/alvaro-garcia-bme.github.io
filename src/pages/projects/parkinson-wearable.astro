					<line x1="381" y1="98" x2="381" y2="122" stroke="#1e3a8a" stroke-width="2.5"/>
					<text x="378" y="92" fill="#1e3a8a" font-size="8" font-family="monospace" text-anchor="middle" font-weight="bold">C1: 10&mu;F</text>
					<path d="M 381 110 L 440 110" stroke="#1e3a8a" stroke-width="1.8" fill="none"/>

					<!-- Virtual Ground Reference Bias Divider (R1 & R2) -->
