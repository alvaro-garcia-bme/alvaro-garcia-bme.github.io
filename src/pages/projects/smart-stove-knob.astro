---
import MainLayout from '../../layouts/MainLayout.astro';

const metrics = [
	{ label: 'Prototype BOM', value: '$27.12', detail: 'Target retail < $50 (vs $129–$498 competitors)' },
	{ label: 'Return Torque', value: '0.328 N·m', detail: 'Mean across 800 trials · σ = 0.006 N·m' },
	{ label: 'Shutoff Success', value: '98.7%', detail: '148/150 servo release trials across 5 angles' },
	{ label: 'Stove Coverage', value: '800 Burners', detail: '10 electric + 10 gas stoves · 4 burners each' },
];

const bomItems = [
	{ component: 'ESP32-C3 Microcontroller', specs: 'RISC-V 32-bit core, BLE 4.2, 4 MB flash, deep-sleep <5 µA', cost: '$5.41' },
	{ component: 'PIR Sensor (AM312)', specs: 'Miniature cylindrical, 3–6 m range, 100–120° FOV, 3.3 V, <20 µA', cost: '$1.63' },
	{ component: 'Hall Effect Sensor (A3144)', specs: 'Lateral mount switch, 6 mm NdFeB magnet, open-drain gating', cost: '$0.38' },
	{ component: 'Micro Servo SG90 ×2', specs: 'Horizontal mount, 4.8 V, 1.8 kg·cm, 2.5 mm axial thrust', cost: '$4.34' },
	{ component: 'Flat Spiral Spring', specs: 'AISI 1095 hardened steel, 6×0.5 mm strip, T_nom = 0.325 N·m', cost: '$3.26' },
	{ component: 'Custom PCB (Circular Ø68 mm)', specs: '2-layer FR4, 1.6 mm, HASL, Gerber-fabricated EasyEDA', cost: '$1.00' },
	{ component: 'Wiring + Connectors', specs: 'JST-PH 2.0 mm, 22 AWG silicone wiring, heat-shrink', cost: '$0.04' },
	{ component: 'Fasteners & Consumables', specs: 'M2 standoffs, Sn63/Pb37 solder, flux, structural adhesive pad', cost: '$10.00' },
	{ component: 'NdFeB Permanent Magnet', specs: '6 mm disc, N52 grade, embedded in bottom case lateral pocket', cost: '$0.06' },
	{ component: 'Li-Ion Battery + USB-C', specs: '3.7 V 1200 mAh LiPo rechargeable, TP4056 charge controller', cost: '~$1.00' },
];

const competitors = [
	{ name: 'SmartKnob (Ours)', detection: 'PIR (AM312) + Inactivity Timer', actuation: 'Mechanical spring return (fail-safe)', gas: true, install: true, price: '< $50', highlight: true },
	{ name: 'Ome Smart Knob', detection: 'Knob position timer only', actuation: 'Motor-driven rotation (active)', gas: true, install: true, price: '~$129', highlight: false },
	{ name: 'Smarturns', detection: 'PIR + external hub', actuation: 'Alert only (no physical shutoff)', gas: true, install: true, price: '~$245', highlight: false },
	{ name: 'iGuardStove', detection: 'PIR + inline timer', actuation: 'Electrical power cutoff only', gas: false, install: false, price: '~$199', highlight: false },
	{ name: 'FireAvert', detection: 'Smoke alarm sound trigger', actuation: 'Electrical power cutoff only', gas: false, install: false, price: '~$498', highlight: false },
];

const pivots = [
	{ v: 'V1–V3', title: 'First Functional Spring', desc: 'Rotational spring mechanism validated. Identified yield failure in conventional torsion wire; pivoted to flat spiral clock-spring.' },
	{ v: 'V4–V6', title: 'Solenoid → Dual Servo Pivot', desc: 'Solenoid current spike and axial stroke insufficient under high torque. Replaced with dual horizontal SG90 micro servos.' },
	{ v: 'V7–V10', title: 'Internal Ridge Profile (Variant A)', desc: 'Eliminated separate pawl. Integrated 12 radial ramp ridges into bottom case inner wall with 3 locking legs on top case shaft.' },
	{ v: 'V11–V12', title: 'Snap-Fit & Coaxial Integration', desc: 'Final snap-fit latches permitting 2.5 mm axial travel with hard retention stop. Coaxial runout ≤0.1 mm across full 350° rotation.' },
];

const springData = [
	{ width: '6', thickness: '0.4', torque: '0.208', sf: '1.03', status: 'Low margin' },
	{ width: '6', thickness: '0.5', torque: '0.325', sf: '1.62', status: 'SELECTED ◄' },
	{ width: '6', thickness: '0.6', torque: '0.468', sf: '2.33', status: 'Pass (oversized)' },
	{ width: '8', thickness: '0.5', torque: '0.433', sf: '2.16', status: 'Pass' },
	{ width: '10', thickness: '0.5', torque: '0.542', sf: '2.69', status: 'Pass (oversized)' },
];

const testResults = [
	{ test: 'Servo Disengagement (45°–350°)', trials: '150', result: '148/150 (98.7%)', note: '100% success after symmetric horn alignment' },
	{ test: 'Spring Return Torque (0°–360°)', trials: '50', result: '0.318–0.337 N·m', note: 'Mean 0.328 N·m, all > 0.305 N·m requirement' },
	{ test: 'Shaft Compatibility (3 Types)', trials: '50', result: '50/50 (100%)', note: 'D-Shaft, Double-D, Round/Splined (4–8 mm)' },
	{ test: 'Thermal Stability (Sustained)', trials: '134°C stove panel', result: '< 0.5 mm deflection', note: 'Worst-case top-mount electric range' },
	{ test: 'Ridge Retention Endurance', trials: '500 cycles', result: '< 0.1 mm wear', note: 'Zero crack initiation at ridge root fillet' },
	{ test: 'BLE Pairing Latency', trials: '6 users', result: '42 s mean', note: 'From app launch to confirmed device handshake' },
	{ test: 'Tool-Free Installation', trials: '6 users', result: '4.6 min mean', note: 'Range 3.4–5.9 min, zero hand tools required' },
];

const scaleData = [
	{ units: '1,000', cost: '$28.15' },
	{ units: '10,000', cost: '$16.98' },
	{ units: '50,000', cost: '$13.25' },
	{ units: '100,000', cost: '$10.98' },
];

const parts = [
	{ 
		id: 'pir', 
		num: '①', 
		name: 'PIR Sensor (AM312)', 
		cad: 'AM312_Module.SLDPRT',
		material: 'Pyroelectric ceramic / HDPE Fresnel dome',
		role: 'Proximity & Human Presence Detection',
		desc: 'Miniature cylindrical passive infrared sensor mounted pointing upward through a dedicated Ø10 mm aperture on the top case face. Detects adult thermal motion at 3–6 meters within a 100–120° solid detection cone. Quiescent current consumption is under 20 µA at 3.3 V. By mounting on the outward-facing rotating shell, it maintains an uninterrupted field of view toward the standing cook regardless of knob rotation angle.', 
		specs: ['Type: AM312 Cylindrical', 'Range: 3–6 meters', 'FOV: 100–120° Cone', 'Draw: <20 µA Quiescent', 'Port: Ø10 mm face aperture'] 
	},
	{ 
		id: 'top', 
		num: '②', 
		name: 'Top Case (Rotating Shell)', 
		cad: 'Top_part_case_v12.SLDPRT',
		material: 'High-Temp PLA (Prototype) / PA12-CF (Production)',
		role: 'User Interface & Ratchet Locking Member',
		desc: 'Matte black cylindrical lid (Ø86.00 mm outer diameter, 19.70 mm height) that rotates with the cook\'s hand. Extends a central shaft (Ø7.00 mm bore) with 3 integrated radial locking legs (Detail C on drawing) that ride along the 12 inner ridges of the bottom case. Features an aperture for the AM312 PIR sensor and internal pockets for the rechargeable battery pack. Section D-D shows 1.00 mm wall thickness with reinforced 2.35 mm hub.', 
		specs: ['Diameter: Ø86.00 mm', 'Height: 19.70 mm', '3 Locking Legs (Detail C)', 'PIR Aperture: Ø10.00 mm', 'Finish: Matte VDI 30'] 
	},
	{ 
		id: 'battery', 
		num: '③', 
		name: 'Rechargeable Battery & USB-C', 
		cad: 'Battery_Pack_1200mAh.SLDPRT',
		material: 'Lithium-Polymer Cell / TP4056 IC',
		role: 'Power Management & Fail-Safe Energy',
		desc: '3.7 V 1200 mAh LiPo rechargeable battery with integrated TP4056 charging IC and USB-C port on the side wall (also compatible with 3× AA configuration). Crucially, the battery circuit is physically gated by the lateral reed switch (Hall effect) at the OFF position: when the stove is off, the circuit is open, resulting in true zero-current standby (0 µA). A depleted battery cannot prevent physical shutoff, as return energy is stored mechanically in the spring.', 
		specs: ['Chemistry: LiPo (3.7 V 1200 mAh)', 'Charging: USB-C (5 V / 1 A)', 'Standby Draw: 0 µA at OFF (Hardware gate)', 'Burst: 1.2 A for dual servos'] 
	},
	{ 
		id: 'middle', 
		num: '④', 
		name: 'PCB Case (Middle Case)', 
		cad: 'PCB case V12.SLDPRT',
		material: 'High-Temp PLA (FDM)',
		role: 'Electronics Enclosure & Coaxial Alignment Spacer',
		desc: 'Cylindrical structural sleeve (Ø86.00 mm outer diameter, 75.00 mm section height, 20.00 × 19.00 mm cross-section) positioned between the top and bottom cases. It houses and protects the circular PCB, isolating electronics from thermal conduction and grease. Features an external alignment key tab (3.55 × 10.97 mm, R3.95 mm) that interlocks with the bottom case to guarantee strict coaxial alignment without rotational play.', 
		specs: ['CAD: PCB case V12.SLDPRT', 'Outer Diameter: Ø86.00 mm', 'Section Height: 75.00 mm', 'Key Tab: 3.55 × 10.97 mm', 'FR4 Board Tray: Ø68.00 mm'] 
	},
	{ 
		id: 'pcb', 
		num: '⑤', 
		name: 'Circular PCB + ESP32-C3', 
		cad: 'SmartKnob_PCB_v2.epro',
		material: '2-Layer FR4 / 1.6 mm / HASL Lead-Free',
		role: 'System Brain, Sensing I/O & BLE Comms',
		desc: 'Custom circular PCB (Ø68.00 mm) centered on an ESP32-C3 32-bit RISC-V microcontroller (160 MHz). Routes PWM signal channels to both SG90 micro servos, reads the digital output from the AM312 PIR sensor, monitors the lateral Hall effect switch, samples battery voltage via resistor divider, and manages the 2.4 GHz BLE 4.2 protocol stack for instantaneous pairing with the companion mobile application.', 
		specs: ['MCU: ESP32-C3 (RISC-V 160 MHz)', 'Wireless: BLE 4.2 (2.4 GHz)', 'Layers: 2-layer FR4 (1.6 mm)', 'GPIO: 6 lines utilized', 'Quiescent Sleep: <5 µA'] 
	},
	{ 
		id: 'servos', 
		num: '⑥', 
		name: 'Dual Micro Servos SG90 (Horizontal)', 
		cad: 'TowerPro_SG90_Micro.SLDPRT',
		material: 'POM Gear Train / Polycarbonate Housing',
		role: 'Axial Disengagement Actuators',
		desc: 'Two SG90 micro servos mounted HORIZONTALLY in dedicated lateral cavities within the bottom case. When the ESP32-C3 issues a release command (due to expired inactivity timer or user remote shutoff), both servos fire simultaneously in a short PWM burst (<1.5 s). Their output horns push against the underside of the top case, imparting a 2.5 mm vertical axial displacement that lifts the 3 locking legs clear of the 12 radial ridges, instantly releasing the wound spring.', 
		specs: ['Model: Tower Pro SG90 × 2', 'Torque: 1.8 kg·cm @ 4.8 V', 'Mounting: Horizontal (Zero axial height impact)', 'Travel: 2.5 mm axial lift', 'Burst Duration: 1.2 seconds'] 
	},
	{ 
		id: 'spring', 
		num: '⑦', 
		name: 'Flat Spiral Spring (Clock Spring)', 
		cad: 'Spiral_spring_v12_snapfit.SLDPRT',
		material: 'AISI 1095 Hardened Spring Steel Strip',
		role: 'Mechanical Potential Energy Storage',
		desc: 'Constant-torque clock spring manufactured from 6.0 mm wide × 0.5 mm thick AISI 1095 spring steel strip. Housed within the lower bore of the bottom case. Unlike coil torsion springs whose stress scales linearly with rotation angle θ (exceeding allowable bending stress at large angles), flat spiral spring stress is governed by strip thickness and minimum mandrel radius (independent of θ). Delivers a nominal return torque of 0.325 N·m from 0° to 350° with a 1.62× safety factor.', 
		specs: ['Material: AISI 1095 Hardened Steel', 'Strip: 6.0 mm width × 0.5 mm thickness', 'Nominal Torque: 0.325 N·m (Constant)', 'Safety Factor: 1.62× vs 0.201 N·m peak', 'Stroke: 0° to 350° continuous'] 
	},
	{ 
		id: 'bottom', 
		num: '⑧', 
		name: 'Bottom Case (Stationary Base)', 
		cad: 'Casing_v12_snap_fit.SLDPRT',
		material: 'High-Temp PLA / PA12-CF (150°C Rated)',
		role: 'Stove Anchor, Ratchet Ridges & Spring Cavity',
		desc: 'The stationary base of the assembly (Ø86.00 mm outer diameter, Ø50.00 mm inner bore, 32.50 mm height). Anchored to the stove control panel via a structural high-temperature adhesive pad. The inner wall incorporates 12 evenly distributed radial ridges (Detail C on drawing) with 30° spacing: ramped on the clockwise face for smooth manual rotation, steep on the counter-clockwise face to arrest spring return torque. Also houses the 4 snap-fit retention latches (Detail D), lateral magnet pocket (Detail F), and USB-C port cutout.', 
		specs: ['Outer Diameter: Ø86.00 mm', 'Bore Diameter: Ø50.00 mm', '12 Radial Ridges (R38 mm, Detail C)', '4 Snap-Fit Latches (Detail D, 2.93 mm)', 'Lateral Magnet Slot (Detail F: 3.27 × 1.63 mm)'] 
	},
	{ 
		id: 'adapter', 
		num: '⑨', 
		name: 'Modular Shaft Adapter (3 Types)', 
		cad: 'Shaft_Adapter_Universal.SLDPRT',
		material: 'Machined 6061-T6 Aluminum / Set-Screw Sleeve',
		role: 'Universal Valve Stem Coupling',
		desc: 'Modular set-screw adapter sleeve positioned at the bottom center, coupling the internal mechanism directly to the stove valve stem. Shipped pre-installed in one of 3 interchangeable profile types covering 100% of residential gas and electric ranges: (1) D-Shaft, (2) Double-D Shaft, and (3) Round / Splined Shaft (4–8 mm diameter range). Tested across 800 burners (20 residential stoves: 10 electric, 10 gas) with zero slippage under 0.35 N·m reverse torque.', 
		specs: ['Profiles: D-Shaft, Double-D, Round/Splined (3 Types)', 'Diameter Range: 4 to 8 mm', 'Fixation: M3 Stainless Steel Set-Screw', 'Validation: 800 burners tested (100% pass)', 'Installation: Slip-on, zero tools needed'] 
	},
];
---

<MainLayout activeTab="projects" title="Smart Stove Safety Knob | Álvaro García Casas">
	<!-- Breadcrumb -->
	<div class="pt-8 pb-4">
		<a href="/projects" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#1a4478] hover:text-[#10172b] transition-colors">&larr; Back to Engineering Projects</a>
	</div>

	<!-- Hero Header -->
	<header class="pb-10 border-b border-[#10172b]/10">
		<div class="flex flex-wrap items-center gap-2 mb-3">
			<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#1a4478]/10 text-[#1a4478] uppercase tracking-wider">Mechatronics &amp; Product Design</span>
			<span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-slate-200 text-slate-700">CREATE-X Startup Accelerator &bull; Georgia Tech</span>
			<span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-amber-100 text-amber-800">Capstone Design Expo &bull; 2026</span>
		</div>
		<h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#10172b] tracking-tight leading-tight">Smart Stove Safety Knob</h1>
		<p class="mt-4 text-base sm:text-lg text-[#485569] max-w-4xl leading-relaxed">
			A fail-safe retrofit device that automatically shuts off unattended stovetops. A flat spiral clock spring stores mechanical return energy when turned ON; 12 radial ridges on the stationary inner casing retain the torque passively with zero electrical power. When the AM312 PIR sensor detects no presence and the user fails to respond via the BLE companion app, dual horizontal micro servos disengage the 3 locking legs via a 2.5 mm axial lift, and the spring drives the valve back to OFF. Gas &amp; electric compatible, tool-free install, sub-&dollar;50 BOM.
		</p>
		<div class="mt-6 flex flex-col md:flex-row md:items-center justify-between gap-4 pt-6 border-t border-[#10172b]/10 text-xs text-[#485569]">
			<div class="flex flex-wrap items-center gap-4">
				<span><strong class="text-[#10172b]">Lead Engineer &amp; PM:</strong> Álvaro García Casas</span>
				<span><strong class="text-[#10172b]">Program:</strong> CREATE-X &middot; Georgia Institute of Technology</span>
			</div>
			<div class="flex flex-wrap gap-1.5">
				{['Customer Discovery', 'Product Management', 'Market Validation', 'Regulatory Compliance', 'BOM & Cost Optimization', 'Go-to-Market Strategy', 'User Interviews', 'Patent & IP Strategy', 'FMEA Risk Analysis'].map(skill => (
					<span class="px-2.5 py-1 rounded-md bg-[#1a4478]/10 border border-[#1a4478]/20 text-[#1a4478] font-medium text-[11px]">{skill}</span>
				))}
			</div>
		</div>
	</header>

	<!-- Metrics Strip -->
	<section class="py-10">
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			{metrics.map(m => (
				<div class="bg-white rounded-xl p-5 border border-slate-200 shadow-2xs">
					<span class="text-xs font-medium text-[#485569] uppercase tracking-wider block mb-1">{m.label}</span>
					<div class="text-2xl sm:text-3xl font-extrabold text-[#10172b] font-mono">{m.value}</div>
					<span class="text-xs text-slate-500 mt-2 block font-medium">{m.detail}</span>
				</div>
			))}
		</div>
	</section>

	<!-- Product Architecture: Assembled 3D Prototype & Technical CAD Drawings -->
	<section class="py-8">
		<div class="bg-[#0b1220] rounded-2xl p-6 sm:p-8 text-white shadow-xl border border-slate-800">
			<!-- Header & Navigation Tabs -->
			<div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-slate-800">
				<div class="flex items-center gap-2">
					<span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
					<h2 class="text-lg font-bold uppercase tracking-wider text-slate-100">Product Architecture &amp; SolidWorks CAD Drawings</h2>
				</div>
				<div class="flex flex-wrap gap-2" id="gallery-tabs">
					<button data-tab="product" class="gallery-tab active px-4 py-2 rounded-lg text-xs font-bold font-mono bg-[#1a4478] text-white border border-cyan-400/30 transition-all cursor-pointer">
						1 &middot; Assembled 3D Prototype
					</button>
					<button data-tab="drawings" class="gallery-tab px-4 py-2 rounded-lg text-xs font-bold font-mono bg-slate-800 text-slate-300 border border-slate-700 hover:bg-slate-700 transition-all cursor-pointer">
						2 &middot; SolidWorks Technical Drawings (4 Sheets)
					</button>
				</div>
			</div>

			<!-- TAB 1: ASSEMBLED 3D PRODUCT VIEW -->
			<div class="gallery-content mt-6" id="tab-product">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
					<div class="lg:col-span-7">
						<div class="relative rounded-2xl overflow-hidden border border-slate-700 bg-gradient-to-b from-slate-900 to-[#081422] p-2 shadow-2xl">
							<img src="/images/projects/smartknob-assembled.jpg" alt="SmartKnob V12 Final Prototype installed on gas stovetop with AM312 PIR sensor" class="w-full h-auto object-cover rounded-xl" loading="lazy" />
							<div class="absolute bottom-4 left-4 right-4 flex items-center justify-between px-3 py-2 rounded-lg bg-black/70 backdrop-blur-md border border-white/10 text-[11px] font-mono">
								<span class="text-cyan-300 flex items-center gap-1.5">
									<span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
									AM312 PIR Dome Protruding Through Top Aperture
								</span>
								<span class="text-slate-400">Matte Black PLA &middot; Ø86 &times; 32.5 mm</span>
							</div>
						</div>
					</div>
					<div class="lg:col-span-5 space-y-4">
						<div class="flex items-center gap-2">
							<span class="px-2.5 py-1 rounded bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 font-mono text-xs">
								V12 Physical Prototype
							</span>
							<span class="px-2.5 py-1 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-mono text-xs">
								AM312 Sensor Integrated
							</span>
						</div>

						<h3 class="text-xl font-extrabold text-white">Non-Intrusive Retrofit Enclosure</h3>
						<p class="text-xs text-slate-300 leading-relaxed">
							Engineered with a low-profile coaxial form factor (Ø86 mm prototype, 32.5 mm height) that slips directly over existing stove valve stems without modifying the appliance or voiding home insurance warranties.
						</p>

						<div class="space-y-2 text-xs font-mono">
							<div class="flex justify-between text-slate-400 border-b border-slate-800 pb-1.5">
								<span>PIR Integration</span>
								<span class="text-cyan-300 font-semibold">AM312 protruding through top aperture</span>
							</div>
							<div class="flex justify-between text-slate-400 border-b border-slate-800 pb-1.5">
								<span>Enclosure Material</span>
								<span class="text-white font-semibold">High-Temp PLA (150°C rating)</span>
							</div>
							<div class="flex justify-between text-slate-400 border-b border-slate-800 pb-1.5">
								<span>Thermal Resistance</span>
								<span class="text-white font-semibold">Tested up to 134°C sustained</span>
							</div>
							<div class="flex justify-between text-slate-400 border-b border-slate-800 pb-1.5">
								<span>Charging Interface</span>
								<span class="text-white font-semibold">USB-C lateral slot (Li-Ion 1200 mAh)</span>
							</div>
							<div class="flex justify-between text-slate-400 border-b border-slate-800 pb-1.5">
								<span>Valve Shaft Compatibility</span>
								<span class="text-white font-semibold">3 types: D, Double-D, Round/Splined</span>
							</div>
							<div class="flex justify-between text-slate-400">
								<span>Installation Time</span>
								<span class="text-emerald-400 font-semibold">Slip-on, tool-free (4.6 min mean)</span>
							</div>
						</div>

						<div class="pt-2">
							<button id="btn-goto-drawings" class="w-full py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold font-mono text-xs transition-colors flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-cyan-500/20">
								<span>📐 Inspect SolidWorks Technical Drawings &amp; Cotas</span> &rarr;
							</button>
						</div>
					</div>
				</div>
			</div>

			<!-- TAB 3: SOLIDWORKS TECHNICAL DRAWINGS (PLANOS TÉCNICOS) -->
			<div class="gallery-content hidden mt-6" id="tab-drawings">
				<div class="mb-4 flex flex-wrap items-center justify-between gap-3 p-3 rounded-xl bg-slate-900 border border-slate-800">
					<div class="flex flex-wrap gap-2" id="drawing-tabs">
						<button data-drawing="assembly" class="drawing-tab active px-3 py-1.5 rounded-lg text-xs font-bold font-mono bg-cyan-500/20 text-cyan-300 border border-cyan-400/40 cursor-pointer">
							Sheet 1 &middot; Assembly Drawing
						</button>
						<button data-drawing="bottom" class="drawing-tab px-3 py-1.5 rounded-lg text-xs font-bold font-mono bg-slate-800 text-slate-400 border border-slate-700 hover:bg-slate-700 cursor-pointer">
							Sheet 2 &middot; Bottom Case (12 Ridges)
						</button>
						<button data-drawing="topcase" class="drawing-tab px-3 py-1.5 rounded-lg text-xs font-bold font-mono bg-slate-800 text-slate-400 border border-slate-700 hover:bg-slate-700 cursor-pointer">
							Sheet 3 &middot; Top Case (3 Legs)
						</button>
						<button data-drawing="pcbcase" class="drawing-tab px-3 py-1.5 rounded-lg text-xs font-bold font-mono bg-slate-800 text-slate-400 border border-slate-700 hover:bg-slate-700 cursor-pointer">
							Sheet 4 &middot; PCB Case V12 (Middle)
						</button>
					</div>
					<div class="flex items-center gap-2">
						<button id="btn-zoom-in" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-white font-mono text-xs border border-slate-700 cursor-pointer" title="Zoom In">+</button>
						<button id="btn-zoom-out" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-white font-mono text-xs border border-slate-700 cursor-pointer" title="Zoom Out">&minus;</button>
						<button id="btn-zoom-reset" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono text-xs border border-slate-700 cursor-pointer">Reset</button>
					</div>
				</div>

				<!-- Drawing 1: Assembly -->
