<style>
	.drawing-img { transition: transform 0.25s ease-out; transform-origin: center center; }
	.drawing-viewer.zoomed .drawing-img { transform: scale(1.8); cursor: grab; }
</style>

<script is:inline>
	// ==========================================
	// 1. TOP GALLERY TABS (Product / Drawings)
	// ==========================================
	const galleryTabs = document.querySelectorAll('.gallery-tab');
	const galleryContents = document.querySelectorAll('.gallery-content');

	galleryTabs.forEach(tab => {
		tab.addEventListener('click', () => {
			const target = tab.getAttribute('data-tab');
			galleryContents.forEach(c => c.classList.add('hidden'));
			document.getElementById('tab-' + target)?.classList.remove('hidden');

			galleryTabs.forEach(t => {
				t.classList.remove('bg-[#1a4478]', 'text-white', 'border-cyan-400/30');
				t.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
			});
			tab.classList.add('bg-[#1a4478]', 'text-white', 'border-cyan-400/30');
			tab.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
		});
	});

	document.getElementById('btn-goto-drawings')?.addEventListener('click', () => {
		const drawingsTabBtn = document.querySelector('.gallery-tab[data-tab="drawings"]');
		drawingsTabBtn?.click();
	});

	// ==========================================
	// 4. SOLIDWORKS TECHNICAL DRAWINGS VIEWER
	// ==========================================
	const drawingTabs = document.querySelectorAll('.drawing-tab');
	const drawingContainers = document.querySelectorAll('.drawing-view-container');

	drawingTabs.forEach(tab => {
		tab.addEventListener('click', () => {
			const target = tab.getAttribute('data-drawing');
			drawingContainers.forEach(dc => dc.classList.add('hidden'));
			document.getElementById('drawing-' + target)?.classList.remove('hidden');

			drawingTabs.forEach(t => {
				t.classList.remove('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-400/40');
				t.classList.add('bg-slate-800', 'text-slate-400', 'border-slate-700');
			});
			tab.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-400/40');
			tab.classList.remove('bg-slate-800', 'text-slate-400', 'border-slate-700');
			resetDrawingZoom();
		});
	});

	let currentZoom = 1.0;
	function applyZoom(scale) {
		currentZoom = Math.min(Math.max(scale, 0.8), 2.5);
		document.querySelectorAll('.drawing-viewer img').forEach(img => {
			img.style.transform = `scale(${currentZoom})`;
		});
	}

	function resetDrawingZoom() {
		currentZoom = 1.0;
		applyZoom(1.0);
	}

	document.getElementById('btn-zoom-in')?.addEventListener('click', () => applyZoom(currentZoom + 0.3));
	document.getElementById('btn-zoom-out')?.addEventListener('click', () => applyZoom(currentZoom - 0.3));
	document.getElementById('btn-zoom-reset')?.addEventListener('click', () => resetDrawingZoom());

	document.querySelectorAll('.drawing-viewer').forEach(viewer => {
		viewer.addEventListener('click', () => {
			if (currentZoom > 1.0) {
				resetDrawingZoom();
			} else {
				applyZoom(1.8);
			}
		});
	});

	// ==========================================
	// 5. COMPANION MOBILE APP SIMULATOR
	// ==========================================
	const appButtons = document.querySelectorAll('.app-btn');
	const appStates = document.querySelectorAll('.app-state');

	appButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			const targetState = btn.getAttribute('data-app');
			appStates.forEach(s => s.classList.add('hidden'));
			document.getElementById('app-' + targetState)?.classList.remove('hidden');

			appButtons.forEach(b => {
				b.classList.remove('bg-[#1a4478]', 'text-white', 'border-cyan-400/30');
				b.classList.add('bg-slate-100', 'text-slate-700', 'border-slate-200');
			});
			btn.classList.add('bg-[#1a4478]', 'text-white', 'border-cyan-400/30');
			btn.classList.remove('bg-slate-100', 'text-slate-700', 'border-slate-200');

			if (targetState === 'active') startActiveTimer();
			if (targetState === 'alert') startAlertCountdown();
		});
	});

	let activeTimerInt, alertTimerInt;
	function startActiveTimer() {
		clearInterval(activeTimerInt);
		let sec = 522; // 8:42
		const timerEl = document.getElementById('app-timer');
		if (!timerEl) return;
		activeTimerInt = setInterval(() => {
			sec--;
			if (sec <= 0) { clearInterval(activeTimerInt); sec = 522; }
			const m = Math.floor(sec / 60);
			const s = String(sec % 60).padStart(2, '0');
			timerEl.textContent = `${m}:${s}`;
		}, 1000);
	}

	function startAlertCountdown() {
		clearInterval(alertTimerInt);
		let sec = 27;
		const countdownEl = document.getElementById('alert-countdown');
		if (!countdownEl) return;
		alertTimerInt = setInterval(() => {
			sec--;
			if (sec <= 0) {
				clearInterval(alertTimerInt);
				countdownEl.textContent = '0:00';
				return;
			}
			countdownEl.textContent = `0:${String(sec).padStart(2, '0')}`;
		}, 1000);
	}
</script>
