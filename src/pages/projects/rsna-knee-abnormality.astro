				<!-- Uncropped Container: Figure fully visible -->
				<div class="rounded-xl bg-[#080e1a] border border-slate-800 p-2 sm:p-3 flex items-center justify-center h-48 sm:h-56 overflow-hidden">
					<img 
						src="/images/projects/rsna-eda-distribution.png" 
						alt="Pathology Prevalence and Class Imbalance" 
						class="max-h-full max-w-full object-contain mx-auto group-hover:scale-102 transition-transform duration-300"
