							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<!-- Footer Navigation (Clean: "Get in touch" removed per user instruction) -->
	<div class="py-10 border-t border-slate-200 flex items-center justify-center">
		<a href="/projects" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#1a4478] hover:text-[#10172b] transition-colors">
			&larr; Return to All Engineering Projects
		</a>
	</div>

	<!-- Modal Lightbox for Image Zoom -->
	<div id="image-modal" class="fixed inset-0 z-50 bg-[#080e1a]/95 backdrop-blur-md hidden items-center justify-center p-4 sm:p-8 opacity-0 transition-opacity duration-300">
		<div class="relative max-w-5xl w-full bg-slate-900 border border-slate-700 rounded-2xl overflow-hidden shadow-2xl p-4">
			<button id="close-modal" class="absolute top-4 right-4 text-slate-400 hover:text-white text-2xl font-bold z-10 w-9 h-9 rounded-full bg-slate-800/80 flex items-center justify-center border border-slate-700">
				&times;
			</button>
			<img id="modal-img" src="" alt="Enlarged view" class="w-full max-h-[75vh] object-contain rounded-lg" />
			<p id="modal-caption" class="text-xs font-mono text-slate-300 mt-3 text-center px-4"></p>
		</div>
	</div>
</MainLayout>

<script is:inline>
	// ═══════════════════════════════════════════════════════════════════
	// REALISTIC 3T MRI PACS CONSOLE CANVAS SIMULATOR
	// ═══════════════════════════════════════════════════════════════════
	(function() {
		const canvas = document.getElementById('mriCanvas');
		if (!canvas) return;
		const ctx = canvas.getContext('2d');

		// Simulation state
		let currentPlane = 'sagittal';
		let currentCase = 'acl';
		let currentSlice = 8;
		let showHeatmap = true;
		let windowMode = 'standard'; // 'standard', 'bone', 'invert'

		// Pre-load image cache for butter-smooth 60fps scrubbing
		const imgCache = {};

		function getImagePath(plane, caseType, slice) {
			const sStr = slice < 10 ? '0' + slice : '' + slice;
			return `/images/projects/mri/${plane}/${caseType}/slice_${sStr}.png`;
		}

		function getImage(plane, caseType, slice, onReady) {
			const path = getImagePath(plane, caseType, slice);
			if (imgCache[path] && imgCache[path].complete && imgCache[path].naturalWidth > 0) {
				return imgCache[path];
			}
			if (!imgCache[path]) {
				const img = new Image();
				img.onload = () => {
					if (onReady) onReady();
				};
				img.src = path;
				imgCache[path] = img;
			} else {
				const existing = imgCache[path];
				const prev = existing.onload;
				existing.onload = () => {
					if (prev) prev();
					if (onReady) onReady();
				};
			}
			return imgCache[path];
		}

		function preloadActiveSeries() {
			for (let s = 1; s <= 16; s++) {
				getImage(currentPlane, currentCase, s, () => {
					if (s === currentSlice) render();
				});
			}
		}

		function applyWindowFilter() {
			if (windowMode === 'bone') {
				canvas.style.filter = 'contrast(1.4) brightness(0.9) saturate(0)';
			} else if (windowMode === 'invert') {
				canvas.style.filter = 'invert(1) contrast(1.15)';
			} else {
				canvas.style.filter = 'none';
			}
		}

		// Case specifications with calibrated probabilities
		const casesData = {
			acl: {
				title: 'Case A: Complete Mid-Substance ACL Tear + Joint Effusion',
				focus: 'ACL & Synovial Capsule',
				confidence: '96.4%',
				summary: '<strong class="text-cyan-300">[AI Finding]:</strong> Complete mid-substance ACL disruption with extensive hyperintense joint effusion. Grad-CAM confirms 96.4% activation focal to the intercondylar notch.',
				heatmapTarget: {
					sagittal: { x: 245, y: 275, r: 42 },
					coronal: { x: 256, y: 260, r: 40 },
					axial: { x: 355, y: 215, r: 45 }
				},
				probs: [
					{ name: 'ACL Tear', p: 0.964, active: true },
					{ name: 'Effusion', p: 0.978, active: true },
					{ name: 'Bone Contusion', p: 0.812, active: true },
					{ name: 'Medial Meniscus', p: 0.342, active: false },
					{ name: 'Lateral Meniscus', p: 0.281, active: false },
					{ name: 'MCL Tear', p: 0.194, active: false },
				]
			},
			meniscus: {
				title: 'Case B: Complex Medial Meniscus Posterior Horn Tear',
				focus: 'Medial Meniscus Root',
				confidence: '94.8%',
				summary: '<strong class="text-cyan-300">[AI Finding]:</strong> Horizontal cleavage tear involving the posterior horn of the medial meniscus reaching articular surface. Lateral compartment preserved.',
				heatmapTarget: {
					sagittal: { x: 315, y: 288, r: 36 },
					coronal: { x: 175, y: 295, r: 38 },
					axial: { x: 220, y: 270, r: 38 }
				},
				probs: [
					{ name: 'Medial Meniscus', p: 0.948, active: true },
					{ name: 'Effusion', p: 0.724, active: true },
					{ name: 'Medial OA', p: 0.655, active: true },
					{ name: 'Lateral Meniscus', p: 0.150, active: false },
					{ name: 'ACL Tear', p: 0.082, active: false },
					{ name: 'Fracture', p: 0.031, active: false },
				]
			},
			oa: {
				title: 'Case C: Grade IV Medial Compartment Osteoarthritis',
				focus: 'Medial Femoral Cartilage',
				confidence: '93.1%',
				summary: '<strong class="text-cyan-300">[AI Finding]:</strong> Severe joint space narrowing with full-thickness chondral loss and subchondral osteophytosis in medial tibiofemoral compartment.',
				heatmapTarget: {
					sagittal: { x: 230, y: 290, r: 42 },
					coronal: { x: 165, y: 285, r: 48 },
					axial: { x: 240, y: 240, r: 42 }
				},
				probs: [
					{ name: 'Medial OA', p: 0.931, active: true },
					{ name: 'PF OA', p: 0.842, active: true },
					{ name: 'Lateral OA', p: 0.612, active: true },
					{ name: 'Synovitis', p: 0.785, active: true },
					{ name: 'Medial Meniscus', p: 0.890, active: true },
					{ name: 'ACL Tear', p: 0.210, active: false },
				]
			},
			contusion: {
				title: 'Case D: Lateral Tibial Plateau Bone Contusion & Trabecular Microfissure',
				focus: 'Lateral Tibial Epiphysis',
				confidence: '92.9%',
				summary: '<strong class="text-cyan-300">[AI Finding]:</strong> Diffuse geographic trabecular edema pattern in lateral tibial plateau indicative of acute pivot-shift impaction injury.',
				heatmapTarget: {
					sagittal: { x: 270, y: 365, r: 48 },
					coronal: { x: 330, y: 330, r: 45 },
					axial: { x: 320, y: 310, r: 45 }
				},
				probs: [
					{ name: 'Bone Contusion', p: 0.929, active: true },
					{ name: 'Fracture', p: 0.915, active: true },
					{ name: 'Effusion', p: 0.884, active: true },
					{ name: 'ACL Tear', p: 0.745, active: true },
					{ name: 'MCL Tear', p: 0.412, active: false },
					{ name: "Baker's Cyst", p: 0.120, active: false },
				]
			}
		};

		function render() {
			const w = canvas.width;
			const h = canvas.height;

			// Background dark PACS monitor
			ctx.fillStyle = '#040810';
			ctx.fillRect(0, 0, w, h);

			const img = getImage(currentPlane, currentCase, currentSlice, () => render());

			if (img && img.complete && img.naturalWidth > 0) {
				ctx.save();
				ctx.drawImage(img, 0, 0, w, h);
				ctx.restore();

				// ONLY draw Grad-CAM once the MRI scan is drawn!
				if (showHeatmap) {
					drawGradCAM(ctx, w, h);
				}
			} else {
				// PACS Streaming indicator
				ctx.fillStyle = '#38bdf8';
				ctx.font = '12px monospace';
				ctx.textAlign = 'center';
				ctx.fillText('DICOM PACS STREAM: LOADING HIGH-RES SLICE...', w / 2, h / 2);
				ctx.textAlign = 'start';
			}

			// Draw PACS crosshairs & measurement scale
			drawPACSOverlay(ctx, w, h);

			// Update UI text & confidence meters
			updateUI();
		}

		function drawGradCAM(ctx, w, h) {
			const c = casesData[currentCase];
			const target = c.heatmapTarget[currentPlane] || { x: 256, y: 256, r: 40 };

			const hx = target.x;
			const hy = target.y;
			const radius = target.r;

			// Realistic smooth radial thermal gradient
			const grad = ctx.createRadialGradient(hx, hy, 2, hx, hy, radius);
			grad.addColorStop(0, 'rgba(239, 68, 68, 0.85)');    // Red hot core
			grad.addColorStop(0.35, 'rgba(245, 158, 11, 0.60)');  // Amber mid
			grad.addColorStop(0.70, 'rgba(56, 189, 248, 0.30)');  // Cyan periphery
			grad.addColorStop(1, 'rgba(8, 14, 26, 0)');           // Seamless clear fade

			ctx.save();
			ctx.fillStyle = grad;
			ctx.beginPath();
			ctx.arc(hx, hy, radius, 0, Math.PI * 2);
			ctx.fill();

			// Clinical target box
			ctx.strokeStyle = '#ef4444';
			ctx.lineWidth = 1.8;
			ctx.setLineDash([4, 4]);
			ctx.strokeRect(hx - radius * 0.8, hy - radius * 0.8, radius * 1.6, radius * 1.6);
			ctx.setLineDash([]);
			ctx.restore();
		}

		function drawPACSOverlay(ctx, w, h) {
			// Subtle center crosshairs
			ctx.strokeStyle = 'rgba(148, 163, 184, 0.2)';
			ctx.lineWidth = 1;
			ctx.beginPath();
			ctx.moveTo(w / 2, 15);
			ctx.lineTo(w / 2, h - 15);
			ctx.moveTo(15, h / 2);
			ctx.lineTo(w - 15, h / 2);
			ctx.stroke();

			// Scale bar on bottom-right (30 mm)
			const bx = w - 70;
			const by = h - 25;
			ctx.strokeStyle = '#94a3b8';
			ctx.lineWidth = 2;
			ctx.beginPath();
			ctx.moveTo(bx, by);
			ctx.lineTo(bx + 40, by);
			ctx.moveTo(bx, by - 4);
			ctx.lineTo(bx, by + 4);
			ctx.moveTo(bx + 40, by - 4);
			ctx.lineTo(bx + 40, by + 4);
			ctx.stroke();

			ctx.fillStyle = '#94a3b8';
			ctx.font = '9px monospace';
			ctx.fillText('30 mm', bx + 6, by - 6);
		}

		function updateUI() {
			const c = casesData[currentCase];
			
			const planeName = currentPlane === 'sagittal' ? 'Sagittal Proton Density' :
			                  currentPlane === 'coronal' ? 'Coronal T2-Weighted' : 'Axial Fat-Suppressed';
			document.getElementById('hud-plane').textContent = 'Plane: ' + planeName;
			document.getElementById('hud-focus').textContent = 'Target: ' + c.focus;
			document.getElementById('hud-confidence').textContent = 'Model Confidence: ' + c.confidence;
			document.getElementById('hud-slice-indicator').textContent = 'Slice: ' + currentSlice + ' / 16 (Depth: ' + (currentSlice * 3.0).toFixed(1) + ' mm)';
			document.getElementById('slider-slice-val').textContent = 'Slice: ' + (currentSlice < 10 ? '0' : '') + currentSlice + ' of 16';
			document.getElementById('clinical-summary').innerHTML = c.summary;

			// Populate dynamic probability bars
			const container = document.getElementById('pathology-bars');
			container.innerHTML = '';
			c.probs.forEach(p => {
				const percent = (p.p * 100).toFixed(1);
				const isHigh = p.p >= 0.50;
				const barColor = isHigh ? 'bg-gradient-to-r from-cyan-500 to-rose-500' : 'bg-slate-700';
				const textColor = isHigh ? 'text-rose-400 font-bold' : 'text-slate-400';
				
				const row = document.createElement('div');
				row.className = 'flex flex-col space-y-1';
				row.innerHTML = `
					<div class="flex items-center justify-between text-xs font-mono">
						<span class="text-slate-300 font-medium">${p.name}</span>
						<span class="${textColor}">${percent}%</span>
					</div>
					<div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
						<div class="h-full ${barColor} rounded-full transition-all duration-300" style="width: ${percent}%"></div>
					</div>
				`;
				container.appendChild(row);
			});
		}

		// Event Listeners: Planes
		document.querySelectorAll('.plane-btn').forEach(btn => {
			btn.addEventListener('click', () => {
				document.querySelectorAll('.plane-btn').forEach(b => {
					b.classList.remove('active', 'bg-cyan-600', 'text-white');
					b.classList.add('bg-slate-800', 'text-slate-300');
				});
				btn.classList.add('active', 'bg-cyan-600', 'text-white');
				btn.classList.remove('bg-slate-800', 'text-slate-300');
				currentPlane = btn.getAttribute('data-plane');
				preloadActiveSeries();
				render();
			});
		});

		// Event Listeners: Cases
		document.querySelectorAll('.case-btn').forEach(btn => {
			btn.addEventListener('click', () => {
				document.querySelectorAll('.case-btn').forEach(b => {
					b.classList.remove('active', 'border-cyan-500/50', 'text-cyan-300', 'bg-slate-800');
					b.classList.add('border-slate-800', 'text-slate-400', 'bg-slate-900');
				});
				btn.classList.add('active', 'border-cyan-500/50', 'text-cyan-300', 'bg-slate-800');
				btn.classList.remove('border-slate-800', 'text-slate-400', 'bg-slate-900');
				currentCase = btn.getAttribute('data-case');
				preloadActiveSeries();
				render();
			});
		});

		// Event Listener: Slice Slider
		const slider = document.getElementById('sliceRange');
		slider.addEventListener('input', (e) => {
			currentSlice = parseInt(e.target.value, 10);
			render();
		});

		// Event Listener: Heatmap Toggle
		const toggleBtn = document.getElementById('toggle-heatmap');
		const label = document.getElementById('heatmap-label');
		toggleBtn.addEventListener('click', () => {
			showHeatmap = !showHeatmap;
			if (showHeatmap) {
				label.textContent = 'Grad-CAM Overlay: ON';
				toggleBtn.classList.remove('bg-slate-800', 'text-slate-300');
				toggleBtn.classList.add('bg-rose-600', 'text-white');
			} else {
				label.textContent = 'Grad-CAM Overlay: OFF';
				toggleBtn.classList.remove('bg-rose-600', 'text-white');
				toggleBtn.classList.add('bg-slate-800', 'text-slate-300');
			}
			render();
		});

		// Event Listener: Windowing Toggle
		const winBtn = document.getElementById('toggle-windowing');
		const winLabel = document.getElementById('window-label');
		winBtn.addEventListener('click', () => {
			if (windowMode === 'standard') {
				windowMode = 'bone';
				winLabel.textContent = 'Bone High-Contrast';
			} else if (windowMode === 'bone') {
				windowMode = 'invert';
				winLabel.textContent = 'Inverted';
			} else {
				windowMode = 'standard';
				winLabel.textContent = 'Standard';
			}
			applyWindowFilter();
			render();
		});

		// Initial load & render
		applyWindowFilter();
		preloadActiveSeries();
		render();
	})();

	// ═══════════════════════════════════════════════════════════════════
	// MODAL LIGHTBOX CONTROLS
	// ═══════════════════════════════════════════════════════════════════
	(function() {
		const modal = document.getElementById('image-modal');
		const modalImg = document.getElementById('modal-img');
		const modalCaption = document.getElementById('modal-caption');
		const closeBtn = document.getElementById('close-modal');

		if (!modal || !modalImg) return;

		document.querySelectorAll('.visual-card').forEach(card => {
			card.addEventListener('click', () => {
				const src = card.getAttribute('data-src');
				const caption = card.getAttribute('data-caption');
				modalImg.src = src;
				modalCaption.textContent = caption;
				modal.classList.remove('hidden');
				modal.classList.add('flex');
				setTimeout(() => modal.classList.remove('opacity-0'), 10);
			});
		});

		function closeModal() {
			modal.classList.add('opacity-0');
			setTimeout(() => {
				modal.classList.remove('flex');
				modal.classList.add('hidden');
			}, 300);
		}

		closeBtn.addEventListener('click', closeModal);
		modal.addEventListener('click', (e) => {
			if (e.target === modal) closeModal();
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
		});
	})();
</script>
