					</thead>
					<tbody class="divide-y divide-slate-100 font-mono text-xs">
						{pathologies.map((p, idx) => (
							<tr class={idx % 2 === 0 ? 'bg-white hover:bg-slate-50/80 transition-colors' : 'bg-slate-50/40 hover:bg-slate-50/80 transition-colors'}>
								<td class="py-3 px-4 sm:px-6 font-bold text-slate-900 font-sans">
									{p.name}
								</td>
								<td class="py-3 px-4 sm:px-6 text-slate-600">
									<span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-[11px] font-semibold">
										{p.category}
									</span>
								</td>
								<td class="py-3 px-4 sm:px-6 text-slate-600">
									{p.prevalence}
								</td>
								<td class="py-3 px-4 sm:px-6 text-right font-extrabold text-[#1a4478]">
									{p.auc}
								</td>
								<td class="py-3 px-4 sm:px-6 text-center">
									<span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
										<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
										{p.status}
